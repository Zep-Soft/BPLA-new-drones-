<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#06080e">
<title>Сапёр Pro</title>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
  :root {
    --bg-0: #06080e;
    --border: rgba(255,255,255,0.08);
    --border-hi: rgba(255,255,255,0.16);
    --cell: #1e293b;
    --cell-hi: #273449;
    --cell-open: #0f1725;
    --accent: #22d3ee;
    --accent-2: #a855f7;
    --accent-3: #f472b6;
    --danger: #f43f5e;
    --success: #10b981;
    --warning: #f59e0b;
    --text: #f1f5f9;
    --text-dim: #64748b;
    --text-mid: #94a3b8;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body {
    width: 100%; height: 100%; overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
    background: var(--bg-0); color: var(--text);
    user-select: none; -webkit-user-select: none;
    touch-action: manipulation;
  }
  body::before {
    content: ''; position: fixed; inset: -20%;
    background:
      radial-gradient(circle at 15% 10%, rgba(34,211,238,0.18) 0%, transparent 40%),
      radial-gradient(circle at 85% 20%, rgba(168,85,247,0.16) 0%, transparent 45%),
      radial-gradient(circle at 50% 90%, rgba(244,114,182,0.10) 0%, transparent 50%);
    animation: bgFloat 20s ease-in-out infinite alternate;
    pointer-events: none; z-index: 0;
  }
  @keyframes bgFloat {
    0%   { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-3%, 2%) scale(1.05); }
  }

  .screen {
    position: fixed; inset: 0;
    display: none; flex-direction: column;
    z-index: 1;
    padding: calc(12px + env(safe-area-inset-top)) calc(12px + env(safe-area-inset-right)) calc(12px + env(safe-area-inset-bottom)) calc(12px + env(safe-area-inset-left));
    animation: screenIn 0.35s cubic-bezier(0.34, 1.2, 0.64, 1);
  }
  .screen.active { display: flex; }
  @keyframes screenIn {
    from { opacity: 0; transform: translateY(15px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ---------- МЕНЮ ---------- */
  #menu { justify-content: center; align-items: center; gap: 12px; text-align: center; }
  .logo {
    font-size: clamp(38px, 12vw, 64px); font-weight: 900;
    letter-spacing: -2px; margin-bottom: 4px;
    background: linear-gradient(135deg, #22d3ee, #a855f7, #f472b6);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(34,211,238,0.4));
    animation: logoGlow 3s ease-in-out infinite;
  }
  @keyframes logoGlow {
    0%,100% { filter: drop-shadow(0 0 30px rgba(34,211,238,0.4)); }
    50%     { filter: drop-shadow(0 0 40px rgba(168,85,247,0.6)); }
  }
  .logo-sub {
    font-size: clamp(12px, 3.5vw, 15px); color: var(--text-dim);
    font-weight: 700; letter-spacing: 4px; text-transform: uppercase;
    margin-bottom: 20px;
  }
  .menu-league-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 16px;
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--border);
    border-radius: 20px; margin-bottom: 18px;
    font-size: 13px; font-weight: 700;
  }

  .menu-btn {
    width: 100%; max-width: 300px;
    padding: 16px 20px;
    font-size: 16px; font-weight: 900;
    color: var(--text);
    background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
    border: 1px solid var(--border-hi);
    border-radius: 16px;
    cursor: pointer;
    display: flex; align-items: center; gap: 12px;
    transition: all 0.2s;
    text-transform: uppercase; letter-spacing: 0.5px;
    position: relative;
  }
  .menu-btn:active { transform: scale(0.97); background: rgba(255,255,255,0.1); }
  .menu-btn.primary {
    background: linear-gradient(135deg, #22d3ee, #a855f7);
    border-color: transparent;
    color: #06080e;
    box-shadow: 0 8px 24px rgba(34,211,238,0.4);
  }
  .menu-btn svg { width: 22px; height: 22px; flex-shrink: 0; }
  .menu-btn.primary svg { filter: brightness(0); }
  .menu-btn.locked {
    opacity: 0.45;
    filter: grayscale(1);
    cursor: not-allowed;
    pointer-events: auto;
  }
  .menu-btn.locked::after {
    content: '🔒';
    position: absolute; right: 16px;
    font-size: 18px;
  }
  .menu-btn.locked:active { transform: none; }

  /* ---------- TOP BAR ---------- */
  .topbar {
    flex: 0 0 auto;
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 12px;
  }
  .back-btn {
    width: 44px; height: 44px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    border-radius: 12px;
    cursor: pointer; color: var(--text);
    flex-shrink: 0;
  }
  .back-btn:active { transform: scale(0.94); }
  .back-btn svg { width: 20px; height: 20px; }
  .topbar-title { font-size: 18px; font-weight: 900; flex: 1; }

  /* ---------- GAME ---------- */
  header {
    flex: 0 0 auto;
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px;
    background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
    border: 1px solid var(--border);
    border-radius: 18px;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: 0 4px 24px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08);
    margin-bottom: 8px;
  }
  .stat-pill {
    display: flex; align-items: center; gap: 8px;
    padding: 6px 12px 6px 8px;
    background: rgba(0,0,0,0.35);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
    min-width: 88px;
  }
  .stat-pill.right { flex-direction: row-reverse; padding: 6px 8px 6px 12px; }
  .stat-icon { width: 24px; height: 24px; flex-shrink: 0; }
  .stat-icon img { width: 100%; height: 100%; display: block; }
  .stat-value {
    font-size: clamp(16px, 4.6vw, 22px); font-weight: 800;
    font-variant-numeric: tabular-nums; letter-spacing: -0.5px;
    background: linear-gradient(180deg, #fff, #94a3b8);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .stat-pill.warn .stat-value {
    background: linear-gradient(180deg, #fbbf24, #f59e0b);
    -webkit-background-clip: text; background-clip: text;
    animation: warnPulse 1s infinite;
  }
  @keyframes warnPulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }

  #reset {
    position: relative;
    width: clamp(52px, 13vw, 68px);
    height: clamp(52px, 13vw, 68px);
    border: none; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    padding: 8px;
    transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 0 0 2px rgba(255,255,255,0.1), 0 8px 24px rgba(34,211,238,0.4);
  }
  #reset:active { transform: scale(0.9); }
  #reset img { width: 100%; height: 100%; filter: brightness(0) invert(1); }
  #reset.pulse { animation: resetPulse 0.6s ease-out; }
  @keyframes resetPulse {
    0%   { box-shadow: 0 0 0 2px rgba(255,255,255,0.1), 0 0 0 0 rgba(34,211,238,0.6); }
    100% { box-shadow: 0 0 0 2px rgba(255,255,255,0.1), 0 0 0 20px rgba(34,211,238,0); }
  }

  #toolbar {
    flex: 0 0 auto;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px;
    padding: 4px;
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--border);
    border-radius: 14px;
    margin-bottom: 8px;
  }
  .tool-btn {
    padding: 10px 4px;
    font-size: clamp(10px, 2.9vw, 12px); font-weight: 800;
    color: var(--text-mid); background: transparent;
    border: none; border-radius: 10px;
    cursor: pointer; transition: all 0.2s;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
  }
  .tool-btn svg { width: 18px; height: 18px; }
  .tool-btn.active {
    color: #fff;
    background: linear-gradient(135deg, rgba(34,211,238,0.9), rgba(168,85,247,0.9));
    box-shadow: 0 4px 16px rgba(34,211,238,0.3);
  }
  .tool-btn.flag-mode.active {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    box-shadow: 0 4px 16px rgba(245,158,11,0.4);
    color: #1a1a1a;
  }

  #board-wrap {
    flex: 1 1 auto;
    display: flex; align-items: center; justify-content: center;
    min-height: 0;
  }
  #board {
    display: grid; gap: 3px;
    background: rgba(0,0,0,0.5);
    padding: 6px;
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05);
    animation: boardIn 0.5s cubic-bezier(0.34, 1.2, 0.64, 1);
  }
  @keyframes boardIn {
    from { opacity: 0; transform: scale(0.92); }
    to   { opacity: 1; transform: scale(1); }
  }
  .cell {
    display: flex; align-items: center; justify-content: center;
    font-weight: 800;
    background: linear-gradient(145deg, var(--cell), #172033);
    border-radius: 6px; cursor: pointer;
    color: #fff; line-height: 1; overflow: hidden;
    position: relative;
    transition: all 0.1s;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.06), 0 1px 2px rgba(0,0,0,0.3);
  }
  .cell:active:not(.open) { background: var(--cell-hi); transform: scale(0.92); }
  .cell.open {
    background: var(--cell-open); cursor: default;
    animation: pop 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.4);
  }
  @keyframes pop { 0% { transform: scale(0.6); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
  .cell.flag {
    background: linear-gradient(145deg, #fbbf24, #f59e0b);
    box-shadow: 0 0 12px rgba(245,158,11,0.5);
    animation: flagPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes flagPop { 0% { transform: scale(0.7) rotate(-15deg); } 100% { transform: scale(1); } }
  .cell.mine { background: linear-gradient(145deg, #ef4444, #991b1b); }
  .cell.boom {
    background: #fff !important;
    animation: boom 0.8s ease-out; z-index: 5;
  }
  @keyframes boom {
    0%   { box-shadow: 0 0 0 0 #ef4444, inset 0 0 0 0 #fff; transform: scale(1); }
    30%  { box-shadow: 0 0 0 15px rgba(239,68,68,0.6), inset 0 0 20px #fff; transform: scale(1.15); }
    100% { box-shadow: 0 0 0 60px rgba(239,68,68,0), inset 0 0 0 transparent; transform: scale(1); }
  }
  .cell img { width: 72%; height: 72%; display: block; pointer-events: none; }
  .cell[data-n="1"] { color: #38bdf8; text-shadow: 0 0 8px rgba(56,189,248,0.5); }
  .cell[data-n="2"] { color: #34d399; text-shadow: 0 0 8px rgba(52,211,153,0.5); }
  .cell[data-n="3"] { color: #f87171; text-shadow: 0 0 8px rgba(248,113,113,0.5); }
  .cell[data-n="4"] { color: #c084fc; text-shadow: 0 0 8px rgba(192,132,252,0.5); }
  .cell[data-n="5"] { color: #fb923c; text-shadow: 0 0 8px rgba(251,146,60,0.5); }
  .cell[data-n="6"] { color: #22d3ee; text-shadow: 0 0 8px rgba(34,211,238,0.5); }
  .cell[data-n="7"] { color: #f472b6; text-shadow: 0 0 8px rgba(244,114,182,0.5); }
  .cell[data-n="8"] { color: #94a3b8; }
  .ripple {
    position: absolute; border-radius: 50%;
    background: rgba(255,255,255,0.5);
    transform: scale(0);
    animation: rippleAnim 0.5s ease-out;
    pointer-events: none;
  }
  @keyframes rippleAnim { to { transform: scale(3); opacity: 0; } }

  /* ---------- OVERLAY ---------- */
  .overlay {
    position: fixed; inset: 0;
    background: rgba(6,8,14,0.9);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    display: none; align-items: center; justify-content: center;
    z-index: 10; padding: 20px;
    animation: fadeIn 0.3s ease-out;
  }
  .overlay.show { display: flex; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .dialog {
    background: linear-gradient(160deg, rgba(30,41,64,0.95), rgba(8,11,18,0.95));
    border: 1px solid var(--border-hi);
    border-radius: 24px;
    padding: 28px 22px 22px;
    width: 100%; max-width: 340px;
    text-align: center;
    box-shadow: 0 24px 80px rgba(0,0,0,0.8);
    animation: resultIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes resultIn {
    from { transform: scale(0.7) translateY(20px); opacity: 0; }
    to   { transform: scale(1) translateY(0); opacity: 1; }
  }
  .dialog h2 { font-size: 24px; font-weight: 900; margin-bottom: 8px; }
  .dialog h2.win {
    background: linear-gradient(135deg, #34d399, #22d3ee);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .dialog h2.lose {
    background: linear-gradient(135deg, #f87171, #f43f5e);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .dialog p { color: var(--text-dim); font-size: 13px; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; }
  .dialog .big-time {
    font-size: 40px; font-weight: 900; margin: 6px 0 14px;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #22d3ee, #a855f7);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    letter-spacing: -2px;
  }
  .dialog .best {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 13px; font-weight: 700; color: #fbbf24;
    background: rgba(251,191,36,0.1);
    border: 1px solid rgba(251,191,36,0.3);
    padding: 6px 14px; border-radius: 20px;
    margin-bottom: 20px;
  }
  .dialog button {
    width: 100%; padding: 15px;
    font-size: 16px; font-weight: 900;
    color: #06080e;
    background: linear-gradient(135deg, #22d3ee, #a855f7);
    border: none; border-radius: 16px;
    cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px;
    box-shadow: 0 8px 24px rgba(34,211,238,0.4);
    transition: transform 0.1s;
  }
  .dialog button:active { transform: scale(0.96); }
  .dialog button.secondary {
    background: rgba(255,255,255,0.08); color: var(--text);
    box-shadow: none; margin-top: 8px;
  }
  .dialog input {
    width: 100%; padding: 14px;
    font-size: 22px; font-weight: 900; text-align: center;
    color: var(--text);
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--border-hi);
    border-radius: 12px;
    margin-bottom: 12px;
    letter-spacing: 4px;
    text-transform: uppercase;
    outline: none;
  }
  .dialog input::placeholder { color: var(--text-dim); letter-spacing: 2px; }

  #toast {
    position: fixed;
    bottom: calc(24px + env(safe-area-inset-bottom)); left: 50%;
    transform: translateX(-50%) translateY(120px);
    background: linear-gradient(135deg, rgba(30,41,64,0.98), rgba(8,11,18,0.98));
    border: 1px solid var(--border-hi);
    padding: 12px 20px; border-radius: 14px;
    font-size: 13px; font-weight: 700;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 20; pointer-events: none;
    white-space: nowrap;
    box-shadow: 0 12px 40px rgba(0,0,0,0.6);
  }
  #toast.show { transform: translateX(-50%) translateY(0); }

  /* ---------- ЛИГИ ---------- */
  .league-card {
    background: linear-gradient(160deg, rgba(30,41,64,0.8), rgba(8,11,18,0.8));
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px; margin-bottom: 14px;
    text-align: left;
  }
  .league-header { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .league-big-icon {
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; flex-shrink: 0;
    box-shadow: 0 0 20px currentColor;
  }
  .league-info { flex: 1; text-align: left; }
  .league-name { font-size: 18px; font-weight: 900; margin-bottom: 2px; }
  .league-points { font-size: 13px; color: var(--text-dim); font-weight: 700; }
  .progress-bar {
    height: 8px; background: rgba(0,0,0,0.4);
    border-radius: 4px; overflow: hidden; margin-bottom: 6px;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #22d3ee, #a855f7);
    border-radius: 4px;
    transition: width 0.5s;
    box-shadow: 0 0 10px rgba(34,211,238,0.6);
  }
  .progress-text {
    display: flex; justify-content: space-between;
    font-size: 11px; color: var(--text-dim); font-weight: 700;
  }
  .league-list {
    display: flex; flex-direction: column; gap: 6px;
    overflow-y: auto; flex: 1;
    padding-right: 4px;
  }
  .league-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-size: 14px; font-weight: 700;
  }
  .league-item.current {
    background: rgba(34,211,238,0.1);
    border-color: rgba(34,211,238,0.4);
    box-shadow: 0 0 16px rgba(34,211,238,0.2);
  }
  .league-item.locked { opacity: 0.4; }
  .league-item-icon {
    width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
  }
  .league-item-name { flex: 1; }
  .league-item-pts { font-size: 12px; color: var(--text-dim); }

  /* ---------- СТАТИСТИКА ---------- */
  .stats-list { flex: 1; overflow-y: auto; padding-right: 4px; text-align: left; }
  .stat-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 14px;
  }
  .stat-row:last-child { border-bottom: none; }
  .stat-row .label { color: var(--text-mid); font-weight: 600; }
  .stat-row .value {
    font-weight: 900; font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, #22d3ee, #a855f7);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }

  /* ---------- МУЛЬТИПЛЕЕР ---------- */
  .mp-btn {
    width: 100%; padding: 18px 16px;
    background: linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
    border: 1px solid var(--border-hi);
    border-radius: 16px; color: var(--text);
    cursor: pointer; text-align: left;
    margin-bottom: 10px; transition: all 0.2s;
    display: flex; align-items: center; gap: 14px;
  }
  .mp-btn:active { transform: scale(0.97); }
  .mp-btn svg { width: 32px; height: 32px; color: var(--accent); flex-shrink: 0; }
  .mp-btn-text { flex: 1; }
  .mp-btn-title { font-size: 16px; font-weight: 900; margin-bottom: 3px; }
  .mp-btn-desc { font-size: 12px; color: var(--text-dim); font-weight: 600; }

  .mp-status {
    padding: 20px;
    background: rgba(0,0,0,0.4);
    border-radius: 16px;
    text-align: center;
    margin-bottom: 12px;
  }
  .mp-status .status-text {
    font-size: 14px; color: var(--text-mid);
    font-weight: 700; margin-bottom: 12px;
  }
  .mp-code {
    font-size: 42px; font-weight: 900;
    font-family: 'Courier New', monospace;
    background: linear-gradient(135deg, #22d3ee, #a855f7);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    letter-spacing: 8px;
    margin: 10px 0;
    user-select: all;
  }
  .mp-code-hint {
    font-size: 12px; color: var(--text-dim);
    font-weight: 600; margin-bottom: 12px;
  }
  .spinner {
    width: 32px; height: 32px;
    border: 3px solid rgba(34,211,238,0.2);
    border-top-color: #22d3ee;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 12px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .player-bar {
    display: flex; gap: 6px;
    margin-bottom: 8px; flex: 0 0 auto;
  }
  .player-card {
    flex: 1; padding: 10px 12px;
    background: rgba(255,255,255,0.04);
    border: 2px solid transparent;
    border-radius: 12px;
    transition: all 0.3s; text-align: left;
  }
  .player-card.active {
    border-color: var(--accent);
    background: rgba(34,211,238,0.1);
    box-shadow: 0 0 20px rgba(34,211,238,0.3);
  }
  .player-card.winner {
    border-color: var(--success);
    background: rgba(16,185,129,0.15);
    box-shadow: 0 0 20px rgba(16,185,129,0.4);
  }
  .player-card.loser { opacity: 0.5; }
  .player-name { font-size: 11px; color: var(--text-dim); font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; }
  .player-score { font-size: 18px; font-weight: 900; margin-top: 2px; }
  .player-card.active .player-name { color: var(--accent); }

  .confetti {
    position: fixed; width: 8px; height: 8px;
    border-radius: 2px; pointer-events: none; z-index: 100;
    animation: confettiFall 2s linear forwards;
  }
  @keyframes confettiFall {
    0%   { transform: translateY(0) rotate(0); opacity: 1; }
    100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
  }
</style>
</head>
<body>

<!-- ================= МЕНЮ ================= -->
<div class="screen active" id="menu">
  <div class="logo">САПЁР</div>
  <div class="logo-sub">PRO EDITION</div>

  <div class="menu-league-badge" id="menuLeagueBadge">
    <span id="menuLeagueIcon">🥉</span>
    <span id="menuLeagueName">Бронза</span>
    <span style="color:var(--text-dim)">·</span>
    <span id="menuLeaguePts">0</span>
    <span style="color:var(--text-dim)">очков</span>
  </div>

  <button class="menu-btn primary" data-goto="game">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
    Играть
  </button>
  <button class="menu-btn" id="mpMenuBtn" data-goto="multiplayer">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>
    Мультиплеер
  </button>
  <button class="menu-btn" data-goto="leagues">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2z"/>
    </svg>
    Лиги
  </button>
  <button class="menu-btn" data-goto="stats">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 21V9M9 21V3M15 21v-8M21 21V7"/>
    </svg>
    Статистика
  </button>
</div>

<!-- ================= ИГРА ================= -->
<div class="screen" id="game">
  <div class="topbar">
    <button class="back-btn" data-goto="menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </button>
    <div class="topbar-title">Одиночная игра</div>
  </div>

  <header>
    <div class="stat-pill" id="minesPill">
      <div class="stat-icon"><img id="mine-icon" alt=""></div>
      <span class="stat-value" id="mines">10</span>
    </div>
    <button id="reset" aria-label="Новая игра">
      <img id="reset-icon" alt="">
    </button>
    <div class="stat-pill right">
      <div class="stat-icon"><img id="clock-icon" alt=""></div>
      <span class="stat-value" id="timer">0</span>
    </div>
  </header>

  <div id="toolbar">
    <button class="tool-btn active" data-d="easy">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
      <span>ЛЕГКО</span>
    </button>
    <button class="tool-btn" data-d="medium">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
      <span>СРЕДНЕ</span>
    </button>
    <button class="tool-btn" data-d="hard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4.5L18.5 21 12 16.5 5.5 21 7.5 13.5 2 9h7z"/></svg>
      <span>ПРОФИ</span>
    </button>
    <button class="tool-btn flag-mode" id="flagModeBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4M4 4h12l-2 4 2 4H4"/></svg>
      <span>FLAG</span>
    </button>
    <button class="tool-btn" data-goto="stats">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9M9 21V3M15 21v-8M21 21V7"/></svg>
      <span>СТАТИ</span>
    </button>
  </div>

  <div id="board-wrap">
    <div id="board"></div>
  </div>
</div>

<!-- ================= МУЛЬТИПЛЕЕР ================= -->
<div class="screen" id="multiplayer">
  <div class="topbar">
    <button class="back-btn" data-goto="menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </button>
    <div class="topbar-title">Мультиплеер</div>
  </div>

  <div id="mpLobby">
    <button class="mp-btn" id="mpCreateBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      <div class="mp-btn-text">
        <div class="mp-btn-title">Создать игру</div>
        <div class="mp-btn-desc">Получите код и отправьте другу</div>
      </div>
    </button>

    <button class="mp-btn" id="mpJoinBtn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
      <div class="mp-btn-text">
        <div class="mp-btn-title">Присоединиться</div>
        <div class="mp-btn-desc">Введите код друга</div>
      </div>
    </button>

    <div style="margin-top:20px;padding:14px;background:rgba(0,0,0,0.3);border-radius:12px;font-size:12px;color:var(--text-dim);line-height:1.5;">
      ⚡ Гонка на скорость. У вас и у соперника одинаковое поле с одинаковыми минами. Кто первым откроет все безопасные клетки — победил!
    </div>
  </div>

  <div id="mpWaiting" style="display:none;">
    <div class="mp-status">
      <div class="spinner"></div>
      <div class="status-text" id="mpStatusText">Создание комнаты...</div>
      <div class="mp-code" id="mpCode">----</div>
      <div class="mp-code-hint">Отправьте этот код другу</div>
    </div>
    <button class="menu-btn" id="mpCancelBtn" style="max-width:100%;">
      Отменить
    </button>
  </div>

  <div id="mpJoining" style="display:none;">
    <div class="mp-status">
      <div class="spinner" style="display:none;" id="mpJoinSpinner"></div>
      <div class="status-text">Введите код друга</div>
      <input id="mpCodeInput" maxlength="6" placeholder="КОД">
      <button class="dialog button" id="mpConnectBtn" style="width:100%;padding:15px;font-size:16px;font-weight:900;color:#06080e;background:linear-gradient(135deg,#22d3ee,#a855f7);border:none;border-radius:16px;cursor:pointer;text-transform:uppercase;">
        Подключиться
      </button>
    </div>
    <button class="menu-btn" id="mpBackBtn" style="max-width:100%;">
      Назад
    </button>
  </div>

  <!-- Игровой экран мультиплеера -->
  <div id="mpGame" style="display:none;flex:1;flex-direction:column;min-height:0;">
    <div class="player-bar">
      <div class="player-card active" id="mpMeCard">
        <div class="player-name">Вы</div>
        <div class="player-score" id="mpMeScore">0 / 0</div>
      </div>
      <div class="player-card" id="mpOppCard">
        <div class="player-name">Соперник</div>
        <div class="player-score" id="mpOppScore">0 / 0</div>
      </div>
    </div>
    <div id="mpBoardWrap" style="flex:1;display:flex;align-items:center;justify-content:center;min-height:0;">
      <div id="mpBoard"></div>
    </div>
  </div>
</div>

<!-- ================= ЛИГИ ================= -->
<div class="screen" id="leagues">
  <div class="topbar">
    <button class="back-btn" data-goto="menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </button>
    <div class="topbar-title">Лиги</div>
  </div>

  <div class="league-card" id="leagueCurrentCard">
    <div class="league-header">
      <div class="league-big-icon" id="leagueBigIcon" style="background:rgba(34,211,238,0.15);color:#cd7f32;">🥉</div>
      <div class="league-info">
        <div class="league-name" id="leagueCurrentName">Бронза</div>
        <div class="league-points" id="leagueCurrentPts">0 очков</div>
      </div>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" id="leagueProgress" style="width:0%"></div>
    </div>
    <div class="progress-text">
      <span id="leagueProgressFrom">0</span>
      <span id="leagueProgressTo">100</span>
    </div>
  </div>

  <div class="league-list" id="leagueList"></div>
</div>

<!-- ================= СТАТИСТИКА ================= -->
<div class="screen" id="stats">
  <div class="topbar">
    <button class="back-btn" data-goto="menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
    </button>
    <div class="topbar-title">Статистика</div>
  </div>

  <div class="stats-list">
    <div class="stat-row"><span class="label">Текущая лига</span><span class="value" id="statLeague">Бронза</span></div>
    <div class="stat-row"><span class="label">Очки лиги</span><span class="value" id="statLeaguePts">0</span></div>
    <div class="stat-row"><span class="label">Сыграно партий</span><span class="value" id="statPlayed">0</span></div>
    <div class="stat-row"><span class="label">Побед</span><span class="value" id="statWins">0</span></div>
    <div class="stat-row"><span class="label">Процент побед</span><span class="value" id="statRate">0%</span></div>
    <div class="stat-row"><span class="label">Серия побед</span><span class="value" id="statStreak">0</span></div>
    <div class="stat-row"><span class="label">Побед в мультиплеере</span><span class="value" id="statMpWins">0</span></div>
    <div class="stat-row"><span class="label">Рекорд · Легко</span><span class="value" id="statBestEasy">—</span></div>
    <div class="stat-row"><span class="label">Рекорд · Средне</span><span class="value" id="statBestMedium">—</span></div>
    <div class="stat-row"><span class="label">Рекорд · Профи</span><span class="value" id="statBestHard">—</span></div>
  </div>
</div>

<!-- ================= OVERLAY РЕЗУЛЬТАТА ================= -->
<div class="overlay" id="overlay">
  <div class="dialog">
    <img id="result-icon" style="width:80px;height:80px;margin-bottom:8px;" alt="">
    <h2 id="result-title">Победа!</h2>
    <p id="result-subtitle">Ваше время</p>
    <div class="big-time" id="result-time">0 с</div>
    <div class="best" id="result-best">🏆 Рекорд: —</div>
    <div class="best" id="result-league" style="display:none;color:#22d3ee;background:rgba(34,211,238,0.1);border-color:rgba(34,211,238,0.3);">+0 очков лиги</div>
    <button id="againBtn">Играть снова</button>
    <button class="secondary" id="closeResultBtn">В меню</button>
  </div>
</div>

<!-- ================= OVERLAY ВВОДА КОДА ================= -->
<div class="overlay" id="codeOverlay">
  <div class="dialog">
    <h2 style="margin-bottom:12px;">Введите код</h2>
    <input id="codeInput" maxlength="6" placeholder="КОД" autocomplete="off">
    <button id="codeConnectBtn">Подключиться</button>
    <button class="secondary" id="codeCancelBtn">Отмена</button>
  </div>
</div>

<div id="toast"></div>

<script>
(function () {
  // ============================================================
  // ИКОНКИ
  // ============================================================
  const ICONS = {
    mine: 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="16" fill="#111"/><rect x="30" y="4" width="4" height="12" fill="#111"/><rect x="30" y="48" width="4" height="12" fill="#111"/><rect x="4" y="30" width="12" height="4" fill="#111"/><rect x="48" y="30" width="12" height="4" fill="#111"/><rect x="10" y="10" width="10" height="4" fill="#111" transform="rotate(45 15 12)"/><rect x="44" y="10" width="10" height="4" fill="#111" transform="rotate(-45 49 12)"/><rect x="10" y="50" width="10" height="4" fill="#111" transform="rotate(-45 15 52)"/><rect x="44" y="50" width="10" height="4" fill="#111" transform="rotate(45 49 52)"/><circle cx="26" cy="26" r="3" fill="#fff" opacity="0.8"/></svg>'
    ),
    flag: 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect x="14" y="8" width="4" height="48" rx="2" fill="#1a1a1a"/><path d="M18 10 L50 18 L18 26 Z" fill="#1a1a1a"/><rect x="8" y="54" width="20" height="4" rx="2" fill="#1a1a1a"/></svg>'
    ),
    clock: 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="24" fill="none" stroke="#22d3ee" stroke-width="4"/><rect x="30" y="16" width="4" height="18" rx="2" fill="#22d3ee"/><rect x="30" y="30" width="14" height="4" rx="2" fill="#22d3ee"/></svg>'
    ),
    mineHead: 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="16" fill="#22d3ee"/><rect x="30" y="4" width="4" height="12" fill="#22d3ee"/><rect x="30" y="48" width="4" height="12" fill="#22d3ee"/><rect x="4" y="30" width="12" height="4" fill="#22d3ee"/><rect x="48" y="30" width="12" height="4" fill="#22d3ee"/><circle cx="26" cy="26" r="3" fill="#06080e"/></svg>'
    ),
    smile: 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="#fff"/><circle cx="23" cy="26" r="4" fill="#06080e"/><circle cx="41" cy="26" r="4" fill="#06080e"/><path d="M18 38 Q32 52 46 38" fill="none" stroke="#06080e" stroke-width="4" stroke-linecap="round"/></svg>'
    ),
    sad: 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="#fff"/><circle cx="23" cy="26" r="4" fill="#f43f5e"/><circle cx="41" cy="26" r="4" fill="#f43f5e"/><path d="M18 46 Q32 34 46 46" fill="none" stroke="#f43f5e" stroke-width="4" stroke-linecap="round"/></svg>'
    ),
    cool: 'data:image/svg+xml;utf8,' + encodeURIComponent(
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><circle cx="32" cy="32" r="26" fill="#fff"/><rect x="12" y="22" width="40" height="10" rx="4" fill="#06080e"/><rect x="16" y="24" width="14" height="6" rx="2" fill="#22d3ee"/><rect x="34" y="24" width="14" height="6" rx="2" fill="#22d3ee"/><path d="M18 42 Q32 52 46 42" fill="none" stroke="#06080e" stroke-width="4" stroke-linecap="round"/></svg>'
    )
  };

  // ============================================================
  // СЛОЖНОСТИ
  // ============================================================
  const DIFF = {
    easy:   { cols: 9,  rows: 9,  mines: 10, label: 'Легко' },
    medium: { cols: 16, rows: 16, mines: 40, label: 'Средне' },
    hard:   { cols: 16, rows: 30, mines: 99, label: 'Профи' }
  };

  // ============================================================
  // ЛИГИ
  // ============================================================
  const LEAGUES = [
    { id: 'bronze',   name: 'Бронза',   icon: '🥉', min: 0,    max: 100,  color: '#cd7f32' },
    { id: 'silver',   name: 'Серебро',  icon: '🥈', min: 100,  max: 300,  color: '#c0c0c0' },
    { id: 'gold',     name: 'Золото',   icon: '🥇', min: 300,  max: 600,  color: '#ffd700' },
    { id: 'platinum', name: 'Платина',  icon: '💎', min: 600,  max: 1000, color: '#5ce1e6' },
    { id: 'diamond',  name: 'Алмаз',    icon: '💠', min: 1000, max: 1500, color: '#60a5fa' },
    { id: 'master',   name: 'Мастер',   icon: '🏆', min: 1500, max: 2200, color: '#a855f7' },
    { id: 'legend',   name: 'Легенда',  icon: '👑', min: 2200, max: 99999, color: '#f472b6' }
  ];

  function getLeagueByPoints(pts) {
    for (let i = LEAGUES.length - 1; i >= 0; i--) {
      if (pts >= LEAGUES[i].min) return LEAGUES[i];
    }
    return LEAGUES[0];
  }

  // ============================================================
  // ЭЛЕМЕНТЫ
  // ============================================================
  const $ = function (id) { return document.getElementById(id); };
  const screens = document.querySelectorAll('.screen');
  const toastEl = $('toast');

  // ============================================================
  // НАВИГАЦИЯ
  // ============================================================
  function goto(screenId) {
    screens.forEach(function (s) { s.classList.remove('active'); });
    const el = document.getElementById(screenId);
    if (el) el.classList.add('active');
    if (screenId === 'menu') updateMenuBadge();
    if (screenId === 'leagues') renderLeagues();
    if (screenId === 'stats') renderStats();
  }
  document.querySelectorAll('[data-goto]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const target = btn.dataset.goto;
      if (target === 'multiplayer' && !navigator.onLine) {
        toast('📴 Для мультиплеера нужен интернет');
        return;
      }
      goto(target);
    });
  });

  // ============================================================
  // TOAST
  // ============================================================
  let toastTimer = null;
  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 2200);
  }

  // ============================================================
  // ХРАНИЛИЩЕ
  // ============================================================
  function getStat(key, def) {
    const v = localStorage.getItem('saper_' + key);
    return v === null ? def : (isNaN(v) ? v : parseInt(v, 10));
  }
  function setStat(key, val) { localStorage.setItem('saper_' + key, String(val)); }
  function incStat(key, by) { setStat(key, (getStat(key, 0) || 0) + (by || 1)); }

  function getLeaguePoints() { return getStat('leaguePoints', 0); }
  function setLeaguePoints(v) { setStat('leaguePoints', Math.max(0, v)); }

  // ============================================================
  // ВИБРАЦИЯ
  // ============================================================
  function vibrate(p) { if (navigator.vibrate) navigator.vibrate(p); }

  // ============================================================
  // ПРОВЕРКА ИНТЕРНЕТА
  // ============================================================
  function updateOnlineState() {
    const online = navigator.onLine;
    const mpBtn = $('mpMenuBtn');
    if (!mpBtn) return;
    mpBtn.classList.toggle('locked', !online);
  }
  window.addEventListener('online',  function () {
    updateOnlineState();
    toast('🌐 Интернет подключён');
  });
  window.addEventListener('offline', function () {
    updateOnlineState();
    toast('📴 Нет интернета — мультиплеер недоступен');
  });
  updateOnlineState();

  // ============================================================
  // МЕНЮ: БЕЙДЖ ЛИГИ
  // ============================================================
  function updateMenuBadge() {
    const pts = getLeaguePoints();
    const league = getLeagueByPoints(pts);
    $('menuLeagueIcon').textContent = league.icon;
    $('menuLeagueName').textContent = league.name;
    $('menuLeaguePts').textContent = pts;
  }

  // ============================================================
  // ОДИНОЧНАЯ ИГРА
  // ============================================================
  let cols = 9, rows = 9, totalMines = 10;
  let currentDiff = 'easy';
  let cells = [];
  let minesPlaced = false;
  let gameOver = false;
  let flags = 0;
  let opened = 0;
  let timer = null;
  let seconds = 0;
  let started = false;
  let flagMode = false;
  let boardEl = $('board');
  let minesEl = $('mines');
  let minesPill = $('minesPill');
  let timerEl = $('timer');
  let resetBtn = $('reset');
  let resetIcon = $('reset-icon');

  $('mine-icon').src = ICONS.mineHead;
  $('clock-icon').src = ICONS.clock;
  resetIcon.src = ICONS.smile;

  function layoutBoard() {
    const headerH = document.querySelector('#game header').offsetHeight;
    const toolbarH = document.querySelector('#game #toolbar').offsetHeight;
    const topbarH = document.querySelector('#game .topbar').offsetHeight;
    const padding = 24;
    const gap = 16;
    const boardPad = 12;
    const availW = window.innerWidth - padding - boardPad;
    const availH = window.innerHeight - headerH - toolbarH - topbarH - padding - gap - boardPad;
    const cell = Math.floor(Math.min(availW / cols, availH / rows)) - 3;
    const size = Math.max(14, cell);
    boardEl.style.gridTemplateColumns = 'repeat(' + cols + ', ' + size + 'px)';
    boardEl.style.gridTemplateRows    = 'repeat(' + rows + ', ' + size + 'px)';
    boardEl.querySelectorAll('.cell').forEach(function (c) {
      c.style.fontSize = Math.floor(size * 0.55) + 'px';
    });
  }

  function initGame() {
    clearInterval(timer);
    seconds = 0;
    timerEl.textContent = '0';
    started = false;
    minesPlaced = false;
    gameOver = false;
    flags = 0;
    opened = 0;
    minesEl.textContent = totalMines;
    minesPill.classList.remove('warn');
    resetIcon.src = ICONS.smile;
    $('overlay').classList.remove('show');

    const d = DIFF[currentDiff];
    cols = d.cols; rows = d.rows; totalMines = d.mines;

    boardEl.innerHTML = '';
    cells = [];
    for (let i = 0; i < cols * rows; i++) {
      const div = document.createElement('div');
      div.className = 'cell';
      div.dataset.i = i;
      div.addEventListener('click', onCellClick);
      div.addEventListener('contextmenu', onCellRight);
      div.addEventListener('touchstart', onCellTouchStart, { passive: false });
      div.addEventListener('touchend', onCellTouchEnd);
      boardEl.appendChild(div);
      cells.push({ el: div, mine: false, num: 0, open: false, flag: false });
    }
    layoutBoard();
  }

  function neighbors(i, c, r) {
    const x = i % c, y = Math.floor(i / c);
    const res = [];
    for (let dy = -1; dy <= 1; dy++) {
      for (let dx = -1; dx <= 1; dx++) {
        if (!dx && !dy) continue;
        const nx = x + dx, ny = y + dy;
        if (nx >= 0 && nx < c && ny >= 0 && ny < r) res.push(ny * c + nx);
      }
    }
    return res;
  }

  function placeMines(firstIdx) {
    const safe = new Set([firstIdx].concat(neighbors(firstIdx, cols, rows)));
    const cand = [];
    for (let i = 0; i < cols * rows; i++) if (!safe.has(i)) cand.push(i);
    for (let i = cand.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const t = cand[i]; cand[i] = cand[j]; cand[j] = t;
    }
    const count = Math.min(totalMines, cand.length);
    for (let k = 0; k < count; k++) cells[cand[k]].mine = true;
    cells.forEach(function (c, i) {
      if (c.mine) return;
      c.num = neighbors(i, cols, rows).filter(function (n) { return cells[n].mine; }).length;
    });
    minesPlaced = true;
  }

  function startTimer() {
    timer = setInterval(function () {
      seconds++;
      timerEl.textContent = seconds;
    }, 1000);
  }

  function openCell(i) {
    const c = cells[i];
    if (c.open || c.flag || gameOver) return;
    c.open = true;
    c.el.classList.add('open');
    c.el.textContent = '';
    opened++;
    if (c.mine) { lose(i); return; }
    if (c.num > 0) {
      c.el.textContent = c.num;
      c.el.dataset.n = c.num;
    } else {
      neighbors(i, cols, rows).forEach(openCell);
    }
    if (opened === cols * rows - totalMines) win();
  }

  function chord(i) {
    const c = cells[i];
    if (!c.open || c.num === 0) return;
    const nb = neighbors(i, cols, rows);
    const fl = nb.filter(function (n) { return cells[n].flag; }).length;
    if (fl === c.num) {
      nb.forEach(function (n) {
        if (!cells[n].flag && !cells[n].open) openCell(n);
      });
    }
  }

  function toggleFlag(i) {
    if (gameOver) return;
    const c = cells[i];
    if (c.open) return;
    c.flag = !c.flag;
    c.el.classList.toggle('flag', c.flag);
    if (c.flag) {
      const img = document.createElement('img');
      img.src = ICONS.flag;
      c.el.innerHTML = '';
      c.el.appendChild(img);
    } else {
      c.el.innerHTML = '';
    }
    flags += c.flag ? 1 : -1;
    minesEl.textContent = totalMines - flags;
    minesPill.classList.toggle('warn', totalMines - flags < 0);
    vibrate(20);
  }

  function onCellClick(e) {
    if (gameOver) return;
    const i = +e.currentTarget.dataset.i;
    if (!minesPlaced) {
      placeMines(i);
      started = true;
      startTimer();
      if (flagMode) toggleFlag(i); else openCell(i);
      vibrate(15);
      return;
    }
    if (cells[i].open) { chord(i); vibrate(10); return; }
    if (flagMode) { toggleFlag(i); return; }
    openCell(i);
    vibrate(15);
  }

  function onCellRight(e) {
    e.preventDefault();
    if (gameOver || !minesPlaced) return;
    toggleFlag(+e.currentTarget.dataset.i);
  }

  let touchTimer = null;
  let longPressed = false;
  function onCellTouchStart(e) {
    longPressed = false;
    touchTimer = setTimeout(function () {
      longPressed = true;
      const i = +e.currentTarget.dataset.i;
      if (minesPlaced && !gameOver) toggleFlag(i);
      vibrate(25);
    }, 400);
  }
  function onCellTouchEnd(e) {
    clearTimeout(touchTimer);
    if (longPressed) { e.preventDefault(); longPressed = false; }
  }

  function lose(mineIdx) {
    gameOver = true;
    clearInterval(timer);
    vibrate([80, 40, 80, 40, 200]);
    incStat('played');
    // Сброс серии
    setStat('streak', 0);
    cells.forEach(function (c) {
      if (c.mine && !c.flag) {
        c.el.classList.add('open', 'mine');
        const img = document.createElement('img');
        img.src = ICONS.mine;
        c.el.innerHTML = '';
        c.el.appendChild(img);
      } else if (!c.mine && c.flag) {
        c.el.innerHTML = '';
        c.el.textContent = '✕';
        c.el.style.color = '#f43f5e';
      }
    });
    cells[mineIdx].el.classList.add('boom');
    resetIcon.src = ICONS.sad;
    resetBtn.classList.add('pulse');
    setTimeout(function () { resetBtn.classList.remove('pulse'); }, 600);
    setTimeout(function () { showGameResult(false); }, 800);
  }

  function win() {
    gameOver = true;
    clearInterval(timer);
    vibrate([30, 30, 30, 30, 100]);
    incStat('played');
    incStat('wins');
    incStat('streak');
    cells.forEach(function (c) {
      if (c.mine) {
        c.el.classList.add('flag');
        const img = document.createElement('img');
        img.src = ICONS.flag;
        c.el.innerHTML = '';
        c.el.appendChild(img);
      }
    });
    resetIcon.src = ICONS.cool;
    minesEl.textContent = '0';
    resetBtn.classList.add('pulse');
    setTimeout(function () { resetBtn.classList.remove('pulse'); }, 600);

    // Начисление очков лиги
    const basePoints = currentDiff === 'easy' ? 10 : currentDiff === 'medium' ? 25 : 50;
    const speedBonus = Math.max(0, Math.floor((basePoints * 2) - seconds));
    const totalAdd = basePoints + Math.min(speedBonus, basePoints);
    setLeaguePoints(getLeaguePoints() + totalAdd);
    updateMenuBadge();

    spawnConfetti();

    setTimeout(function () { showGameResult(true, totalAdd); }, 600);
  }

  function spawnConfetti() {
    const colors = ['#22d3ee', '#a855f7', '#f472b6', '#10b981', '#fbbf24'];
    for (let i = 0; i < 50; i++) {
      const c = document.createElement('div');
      c.className = 'confetti';
      c.style.left = Math.random() * 100 + 'vw';
      c.style.top = '-20px';
      c.style.background = colors[Math.floor(Math.random() * colors.length)];
      c.style.animationDelay = Math.random() * 0.5 + 's';
      c.style.animationDuration = (1.5 + Math.random() * 1) + 's';
      document.body.appendChild(c);
      setTimeout(function () { c.remove(); }, 3000);
    }
  }

  function showGameResult(isWin, leagueAdd) {
    const diff = DIFF[currentDiff];
    $('result-icon').src = isWin ? ICONS.cool : ICONS.sad;
    const title = $('result-title');
    title.textContent = isWin ? 'Победа!' : 'Взрыв!';
    title.className = isWin ? 'win' : 'lose';
    $('result-subtitle').textContent = 'Ваше время';
    $('result-time').textContent = seconds + ' с';

    const key = 'saper_best_' + currentDiff;
    let best = parseInt(localStorage.getItem(key) || '0', 10);
    if (isWin && (best === 0 || seconds < best)) {
      best = seconds;
      localStorage.setItem(key, String(best));
      toast('🏆 Новый рекорд: ' + best + ' с');
    }
    $('result-best').textContent = '🏆 Рекорд (' + diff.label + '): ' + (best || '—') + ' с';

    const leagueEl = $('result-league');
    if (isWin && leagueAdd) {
      leagueEl.style.display = 'inline-block';
      leagueEl.textContent = '+' + leagueAdd + ' очков лиги';
    } else {
      leagueEl.style.display = 'none';
    }
    $('overlay').classList.add('show');
  }

  resetBtn.addEventListener('click', function () { vibrate(10); initGame(); });
  $('againBtn').addEventListener('click', function () { vibrate(10); initGame(); });
  $('closeResultBtn').addEventListener('click', function () {
    $('overlay').classList.remove('show');
