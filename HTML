  // ============================================================
  // МУЛЬТИПЛЕЕР (PeerJS)
  // ============================================================
  let peer = null;
  let conn = null;
  let mpMode = null; // 'host' | 'guest'
  let mpSeed = null;
  let mpCells = [];
  let mpCols = 9, mpRows = 9, mpMines = 10;
  let mpOpened = 0;
  let mpTotal = 0;
  let mpFlags = 0;
  let mpGameOver = false;
  let mpStarted = false;
  let mpMyScore = 0;
  let mpOppScore = 0;
  let mpBoardEl = $('mpBoard');

  function genCode() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
    let s = '';
    for (let i = 0; i < 5; i++) s += chars[Math.floor(Math.random() * chars.length)];
    return s;
  }

  function resetMpUI() {
    $('mpLobby').style.display = 'block';
    $('mpWaiting').style.display = 'none';
    $('mpJoining').style.display = 'none';
    $('mpGame').style.display = 'none';
    if (conn) { try { conn.close(); } catch (e) {} conn = null; }
    if (peer) { try { peer.destroy(); } catch (e) {} peer = null; }
    mpGameOver = false;
    mpStarted = false;
  }

  $('mpCancelBtn').addEventListener('click', function () {
    resetMpUI();
  });
  $('mpBackBtn').addEventListener('click', function () {
    resetMpUI();
  });

  $('mpCreateBtn').addEventListener('click', function () {
    if (!navigator.onLine) { toast('📴 Нет интернета'); return; }
    if (typeof Peer === 'undefined') { toast('⚠️ PeerJS не загружен'); return; }
    $('mpLobby').style.display = 'none';
    $('mpWaiting').style.display = 'block';
    $('mpStatusText').textContent = 'Создание комнаты...';
    $('mpCode').textContent = '----';

    mpMode = 'host';
    const code = genCode();
    mpSeed = code;

    try {
      peer = new Peer('saper-' + code, { debug: 0 });
    } catch (e) {
      toast('⚠️ Ошибка подключения');
      resetMpUI();
      return;
    }

    peer.on('open', function () {
      $('mpStatusText').textContent = 'Комната создана! Ожидание соперника...';
      $('mpCode').textContent = code;
    });

    peer.on('connection', function (c) {
      conn = c;
      conn.on('open', function () {
        // Отправляем параметры игры
        conn.send({
          type: 'init',
          seed: mpSeed,
          diff: 'easy'
        });
        startMpGame('host');
      });
      conn.on('data', onMpData);
      conn.on('close', function () {
        if (!mpGameOver) {
          toast('❌ Соперник отключился');
          mpGameOver = true;
          showMpResult(true, 'Соперник отключился');
        }
      });
    });

    peer.on('error', function (err) {
      console.error(err);
      if (err.type === 'unavailable-id') {
        toast('⚠️ Код занят, попробуйте снова');
      } else {
        toast('⚠️ Ошибка: ' + err.type);
      }
      resetMpUI();
    });
  });

  $('mpJoinBtn').addEventListener('click', function () {
    if (!navigator.onLine) { toast('📴 Нет интернета'); return; }
    if (typeof Peer === 'undefined') { toast('⚠️ PeerJS не загружен'); return; }
    $('mpLobby').style.display = 'none';
    $('mpJoining').style.display = 'block';
    $('mpCodeInput').value = '';
    $('mpCodeInput').focus();
  });

  $('mpConnectBtn').addEventListener('click', function () {
    const code = $('mpCodeInput').value.trim().toUpperCase();
    if (!code || code.length < 4) { toast('⚠️ Введите код'); return; }

    mpMode = 'guest';
    $('mpJoinSpinner').style.display = 'block';
    $('mpConnectBtn').disabled = true;
    $('mpConnectBtn').textContent = 'Подключение...';

    try {
      peer = new Peer({ debug: 0 });
    } catch (e) {
      toast('⚠️ Ошибка подключения');
      resetMpUI();
      return;
    }

    peer.on('open', function () {
      conn = peer.connect('saper-' + code, { reliable: true });
      conn.on('open', function () {
        $('mpJoinSpinner').style.display = 'none';
        $('mpConnectBtn').disabled = false;
        $('mpConnectBtn').textContent = 'Подключиться';
      });
      conn.on('data', onMpData);
      conn.on('close', function () {
        if (!mpGameOver) {
          toast('❌ Соперник отключился');
          mpGameOver = true;
          showMpResult(true, 'Соперник отключился');
        }
      });
    });

    peer.on('error', function (err) {
      console.error(err);
      toast('⚠️ Не удалось подключиться: ' + err.type);
      $('mpJoinSpinner').style.display = 'none';
      $('mpConnectBtn').disabled = false;
      $('mpConnectBtn').textContent = 'Подключиться';
    });
  });

  $('mpCodeInput').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') $('mpConnectBtn').click();
  });

  function onMpData(data) {
    if (data.type === 'init') {
      // Гость получает параметры от хоста
      mpSeed = data.seed;
      startMpGame('guest');
    } else if (data.type === 'progress') {
      mpOppScore = data.opened;
      $('mpOppScore').textContent = mpOppScore + ' / ' + mpTotal;
    } else if (data.type === 'win') {
      if (!mpGameOver) {
        mpGameOver = true;
        showMpResult(false, 'Соперник победил');
      }
    } else if (data.type === 'lose') {
      if (!mpGameOver) {
        mpGameOver = true;
        showMpResult(true, 'Соперник взорвался');
      }
    }
  }

  // Детерминированный генератор по seed
  function seededRandom(seed) {
    let h = 2166136261;
    for (let i = 0; i < seed.length; i++) {
      h ^= seed.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return function () {
      h ^= h << 13; h ^= h >>> 17; h ^= h << 5;
      return ((h >>> 0) / 4294967296);
    };
  }

  function startMpGame(role) {
    $('mpWaiting').style.display = 'none';
    $('mpJoining').style.display = 'none';
    $('mpGame').style.display = 'flex';

    mpCols = 9; mpRows = 9; mpMines = 10;
    mpTotal = mpCols * mpRows - mpMines;
    mpOpened = 0;
    mpFlags = 0;
    mpMyScore = 0;
    mpOppScore = 0;
    mpGameOver = false;
    mpStarted = false;

    $('mpMeScore').textContent = '0 / ' + mpTotal;
    $('mpOppScore').textContent = '0 / ' + mpTotal;
    $('mpMeCard').className = 'player-card active';
    $('mpOppCard').className = 'player-card';

    // Генерация поля по seed
    const rng = seededRandom(mpSeed);
    mpCells = [];
    mpBoardEl.innerHTML = '';
    for (let i = 0; i < mpCols * mpRows; i++) {
      const div = document.createElement('div');
      div.className = 'cell';
      div.dataset.i = i;
      div.addEventListener('click', onMpCellClick);
      div.addEventListener('contextmenu', onMpCellRight);
      div.addEventListener('touchstart', onMpTouchStart, { passive: false });
      div.addEventListener('touchend', onMpTouchEnd);
      mpBoardEl.appendChild(div);
      mpCells.push({ el: div, mine: false, num: 0, open: false, flag: false });
    }

    // Расстановка мин (безопасная зона вокруг центра)
    const center = Math.floor(mpRows / 2) * mpCols + Math.floor(mpCols / 2);
    const safe = new Set([center].concat(neighbors(center, mpCols, mpRows)));
    const cand = [];
    for (let i = 0; i < mpCols * mpRows; i++) if (!safe.has(i)) cand.push(i);
    for (let i = cand.length - 1; i > 0; i--) {
      const j = Math.floor(rng() * (i + 1));
      const t = cand[i]; cand[i] = cand[j]; cand[j] = t;
    }
    for (let k = 0; k < mpMines; k++) mpCells[cand[k]].mine = true;
    mpCells.forEach(function (c, i) {
      if (c.mine) return;
      c.num = neighbors(i, mpCols, mpRows).filter(function (n) { return mpCells[n].mine; }).length;
    });

    layoutMpBoard();
  }

  function layoutMpBoard() {
    const wrap = $('mpBoardWrap');
    const availW = wrap.clientWidth;
    const availH = wrap.clientHeight;
    const cell = Math.floor(Math.min(availW / mpCols, availH / mpRows)) - 3;
    const size = Math.max(14, cell);
    mpBoardEl.style.gridTemplateColumns = 'repeat(' + mpCols + ', ' + size + 'px)';
    mpBoardEl.style.gridTemplateRows    = 'repeat(' + mpRows + ', ' + size + 'px)';
    mpBoardEl.querySelectorAll('.cell').forEach(function (c) {
      c.style.fontSize = Math.floor(size * 0.55) + 'px';
    });
  }

  function openMpCell(i) {
    const c = mpCells[i];
    if (c.open || c.flag || mpGameOver) return;
    c.open = true;
    c.el.classList.add('open');
    c.el.textContent = '';
    mpOpened++;
    mpMyScore = mpOpened;
    $('mpMeScore').textContent = mpMyScore + ' / ' + mpTotal;

    if (conn && conn.open) conn.send({ type: 'progress', opened: mpOpened });

    if (c.mine) {
      mpGameOver = true;
      c.el.classList.add('mine');
      const img = document.createElement('img');
      img.src = ICONS.mine;
      c.el.innerHTML = '';
      c.el.appendChild(img);
      if (conn && conn.open) conn.send({ type: 'lose' });
      showMpResult(false, 'Вы взорвались');
      return;
    }

    if (c.num > 0) {
      c.el.textContent = c.num;
      c.el.dataset.n = c.num;
    } else {
      neighbors(i, mpCols, mpRows).forEach(openMpCell);
    }

    if (mpOpened === mpTotal) {
      mpGameOver = true;
      if (conn && conn.open) conn.send({ type: 'win' });
      incStat('mpWins');
      incStat('wins');
      incStat('played');
      setLeaguePoints(getLeaguePoints() + 20);
      updateMenuBadge();
      showMpResult(true, 'Вы победили!');
    }
  }

  function onMpCellClick(e) {
    if (mpGameOver) return;
    const i = +e.currentTarget.dataset.i;
    openMpCell(i);
  }
  function onMpCellRight(e) {
    e.preventDefault();
    if (mpGameOver) return;
    const i = +e.currentTarget.dataset.i;
    const c = mpCells[i];
    if (c.open) return;
    c.flag = !c.flag;
    c.el.classList.toggle('flag', c.flag);
    if (c.flag) {
      const img = document.createElement('img');
      img.src = ICONS.flag;
      c.el.innerHTML = '';
      c.el.appendChild(img);
    } else {
      c.el.innerHTML = '';
    }
  }
  let mpTouchTimer = null;
  let mpLongPressed = false;
  function onMpTouchStart(e) {
    mpLongPressed = false;
    mpTouchTimer = setTimeout(function () {
      mpLongPressed = true;
      onMpCellRight(e);
    }, 400);
  }
  function onMpTouchEnd(e) {
    clearTimeout(mpTouchTimer);
    if (mpLongPressed) { e.preventDefault(); mpLongPressed = false; }
  }

  function showMpResult(isWin, message) {
    $('result-icon').src = isWin ? ICONS.cool : ICONS.sad;
    const title = $('result-title');
    title.textContent = isWin ? 'Победа!' : 'Поражение';
    title.className = isWin ? 'win' : 'lose';
    $('result-subtitle').textContent = message;
    $('result-time').textContent = '';
    $('result-best').textContent = '';
    $('result-league').style.display = 'none';
    if (isWin) spawnConfetti();
    $('overlay').classList.add('show');

    if (isWin) {
      $('mpMeCard').className = 'player-card winner';
      $('mpOppCard').className = 'player-card loser';
    } else {
      $('mpMeCard').className = 'player-card loser';
      $('mpOppCard').className = 'player-card winner';
    }
  }

  // Кнопки результата в мультиплеере — переопределяем поведение
  const originalAgain = $('againBtn');
  originalAgain.addEventListener('click', function () {
    $('overlay').classList.remove('show');
    if (mpMode) {
      // В мультиплеере — выход в лобби
      resetMpUI();
    } else {
      initGame();
    }
  }, true);

  $('closeResultBtn').addEventListener('click', function () {
    $('overlay').classList.remove('show');
    if (mpMode) { resetMpUI(); }
    goto('menu');
  });

  // ============================================================
  // РЕСАЙЗ
  // ============================================================
  window.addEventListener('resize', function () {
    layoutBoard();
    if (mpCells.length) layoutMpBoard();
  });
  window.addEventListener('orientationchange', function () {
    setTimeout(function () {
      layoutBoard();
      if (mpCells.length) layoutMpBoard();
    }, 200);
  });

  // Пауза
  document.addEventListener('visibilitychange', function () {
    if (document.hidden && timer) { clearInterval(timer); timer = null; }
    else if (!document.hidden && started && !gameOver && !timer) startTimer();
  });

  // ============================================================
  // СТАРТ
  // ============================================================
  updateMenuBadge();
  initGame();
})();
</script>
</body>
</html>
