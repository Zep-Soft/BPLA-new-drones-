<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Zuno</title>
<style>
  :root{
    --bg:#0b0c10; --bg-2:#0e0f13;
    --surface:#15171d; --surface-2:#1b1e26; --surface-3:#232733;
    --line:rgba(255,255,255,.07); --line-2:rgba(255,255,255,.12);
    --text:#eef0f4; --dim:#8b90a0; --dim-2:#5c6172;
    --accent:#5b8cff; --accent-2:#7aa2ff; --accent-ink:#fff;
    --ok:#3ddc84; --danger:#ff5c5c;
    --radius-xl:26px; --radius-lg:20px; --radius-md:14px; --radius-sm:10px;
    --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    --shadow-1:0 1px 2px rgba(0,0,0,.4);
    --shadow-2:0 8px 24px rgba(0,0,0,.35), 0 2px 6px rgba(0,0,0,.3);
    --shadow-3:0 24px 60px rgba(0,0,0,.5), 0 8px 20px rgba(0,0,0,.35);
    --glow:0 0 0 4px rgba(91,140,255,.18);
    --font-scale:1; --btn-h:48px;
  }
  html[data-theme="light"]{
    --bg:#f5f6f8; --bg-2:#fff;
    --surface:#fff; --surface-2:#f0f2f5; --surface-3:#e6e9ef;
    --line:rgba(0,0,0,.07); --line-2:rgba(0,0,0,.12);
    --text:#111318; --dim:#5b6172; --dim-2:#8b90a0;
    --shadow-3:0 24px 60px rgba(0,0,0,.15), 0 8px 20px rgba(0,0,0,.08);
  }
  html[data-accent="violet"]{--accent:#a06bff;--accent-2:#b98aff;--glow:0 0 0 4px rgba(160,107,255,.2)}
  html[data-accent="lime"]{--accent:#8bd000;--accent-2:#a5e02a;--accent-ink:#0b0c10;--glow:0 0 0 4px rgba(139,208,0,.2)}
  html[data-accent="pink"]{--accent:#ff5c9d;--accent-2:#ff85b6;--glow:0 0 0 4px rgba(255,92,157,.2)}
  html[data-accent="orange"]{--accent:#ff8a3d;--accent-2:#ffa76b;--accent-ink:#1a0e00;--glow:0 0 0 4px rgba(255,138,61,.2)}
  html[data-accent="cyan"]{--accent:#22c8d8;--accent-2:#4fdbeb;--accent-ink:#001417;--glow:0 0 0 4px rgba(34,200,216,.2)}

  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{height:100%; width:100%; overflow:hidden;}
  body{font-family:var(--sans); color:var(--text); background:var(--bg); display:flex; justify-content:center; align-items:center; font-size:calc(15px * var(--font-scale)); -webkit-font-smoothing:antialiased; transition:background .25s, color .25s;}

  .app{width:100%; height:100%; max-width:100%; background:linear-gradient(180deg, var(--bg-2), var(--bg)); display:flex; flex-direction:column; overflow:hidden; position:relative; transition:background .25s;}
  #s-phone, #s-code { justify-content:center; padding:20px; }
  .form { padding:0; max-width:400px; width:100%; margin:0 auto; display:flex; flex-direction:column; gap:18px; }
  .app:has(#s-phone.active) .topbar, .app:has(#s-code.active) .topbar { display:none; }

  .push-sms { position:absolute; top:-100px; left:16px; right:16px; z-index:999; background:rgba(30,32,40,0.98); backdrop-filter:blur(20px) saturate(180%); border:1px solid var(--line-2); border-radius:18px; padding:14px 16px; display:flex; align-items:flex-start; gap:12px; box-shadow:0 10px 40px rgba(0,0,0,.8); transition:top .4s cubic-bezier(.2,.8,.2,1); }
  .push-sms.show { top:16px; }
  .push-ico { width:36px; height:36px; border-radius:10px; background:linear-gradient(135deg, var(--accent), #a06bff); display:grid; place-items:center; color:#fff; font-weight:800; font-size:16px; flex-shrink:0;}
  .push-body { flex:1; }
  .push-title { font-size:13px; font-weight:600; color:var(--text); margin-bottom:2px; display:flex; justify-content:space-between; }
  .push-title span { font-weight:400; font-size:11px; color:var(--dim); }
  .push-text { font-size:14px; color:var(--dim); line-height:1.3; }
  .push-phone { font-family:var(--mono); font-weight:600; color:var(--accent); font-size:13px; margin-bottom:4px;}
  .push-code { font-family:var(--mono); font-weight:700; color:var(--text); font-size:16px; letter-spacing:2px; }

  .topbar{ display:flex; align-items:center; gap:10px; padding:14px 18px; border-bottom:1px solid var(--line); background:color-mix(in srgb, var(--surface) 60%, transparent); backdrop-filter:blur(20px) saturate(180%); flex-shrink:0; position:relative; z-index:2; }
  .dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 3px rgba(61,220,132,.15)} .dot.off{background:var(--dim-2);box-shadow:0 0 0 3px rgba(92,97,114,.15)}
  .brand{font-weight:700;font-size:14px;letter-spacing:.02em} .brand span{color:var(--dim);font-weight:500}
  .spacer{margin-left:auto}
  #status-label{font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--dim);font-family:var(--mono)}
  .icon-btn{ width:36px;height:36px;border-radius:50%; display:grid;place-items:center; background:transparent;border:1px solid var(--line-2); color:var(--dim);cursor:pointer;transition:.15s; flex-shrink:0; }
  .icon-btn:hover{color:var(--text);border-color:var(--line-2);background:var(--surface-2)} .icon-btn svg{width:16px;height:16px}

  .screen{display:none;flex:1;flex-direction:column;min-height:0;position:relative}
  .screen.active{display:flex;animation:screenIn .28s cubic-bezier(.2,.7,.2,1)}
  @keyframes screenIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

  .kicker{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-family:var(--mono);display:flex;align-items:center;gap:8px}
  .kicker::before{content:"";width:16px;height:1px;background:var(--accent);opacity:.6}
  h1{font-size:30px;line-height:1.12;letter-spacing:-.025em;font-weight:700;margin-top:8px}
  h1 .thin{color:var(--dim);font-weight:400}
  .hint{font-size:13.5px;color:var(--dim);line-height:1.55;max-width:36ch}
  .hint b{color:var(--text);font-weight:600}

  .field{display:flex;flex-direction:column;gap:8px}
  .label{font-size:11.5px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:var(--dim)}

  input[type=tel],input[type=text],input[type=email]{
    width:100%; background:var(--surface); border:1px solid var(--line-2);
    border-radius:var(--radius-md); color:var(--text);
    font-size:16.5px; font-family:var(--sans); padding:14px 16px; outline:none;
    transition:border-color .15s, box-shadow .15s, background .15s;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.02);
  }
  input::placeholder{color:var(--dim-2)} input:hover{border-color:rgba(128,128,128,.3)}
  input:focus{border-color:var(--accent);background:var(--surface-2);box-shadow:var(--glow)}
  input.error{border-color:var(--danger);box-shadow:0 0 0 4px rgba(255,92,92,.15)}

  .otp{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .otp input{text-align:center;font-size:22px;font-weight:700;padding:16px 0;font-family:var(--mono);caret-color:var(--accent);border-radius:var(--radius-md)}
  .otp input.filled{border-color:var(--line-2);background:var(--surface-2)}

  .btn{
    width:100%; min-height:var(--btn-h); border:none; border-radius:var(--radius-md);
    background:linear-gradient(180deg, var(--accent-2), var(--accent)); color:var(--accent-ink);
    font-size:15px; font-weight:600; letter-spacing:.01em; padding:0 16px; cursor:pointer;
    display:flex; align-items:center; justify-content:center; gap:8px;
    transition:filter .12s, opacity .12s, box-shadow .12s;
    box-shadow:0 6px 18px color-mix(in srgb, var(--accent) 35%, transparent), inset 0 1px 0 rgba(255,255,255,.2);
    line-height:1;
  }
  .btn:hover{filter:brightness(1.06)} .btn:active{filter:brightness(.96)}
  .btn:disabled{opacity:.45;cursor:not-allowed;filter:none;box-shadow:none}
  .btn.ghost{background:transparent;color:var(--text);border:1px solid var(--line-2);box-shadow:none}
  .btn.ghost:hover{background:var(--surface);border-color:rgba(128,128,128,.3);filter:none}
  .btn.danger{background:linear-gradient(180deg,#ff7a7a,var(--danger));box-shadow:0 6px 18px rgba(255,92,92,.35), inset 0 1px 0 rgba(255,255,255,.2)}

  .feedback{font-size:12.5px;font-weight:500;min-height:18px;line-height:1.4}
  .feedback.err{color:var(--danger)} .feedback.ok{color:var(--ok)}
  .foot{margin-top:auto;font-size:11px;color:var(--dim-2);letter-spacing:.04em;padding-top:12px;display:flex;align-items:center;justify-content:center;gap:6px}
  .foot .sep{width:3px;height:3px;border-radius:50%;background:var(--dim-2)}

  .list-head{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line);background:color-mix(in srgb, var(--surface) 60%, transparent);backdrop-filter:blur(20px) saturate(180%);flex-shrink:0;position:relative;z-index:2}
  .list-head .title{font-weight:700;font-size:18px;letter-spacing:-.02em}
  .search{padding:10px 14px 6px;flex-shrink:0;} .search .wrap-search{position:relative;}
  .search input{padding:10px 14px 10px 38px;font-size:14px;border-radius:12px;background:var(--surface);}
  .search .search-ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--dim-2);pointer-events:none;}

  .chats{flex:1;overflow-y:auto;padding:6px 8px 16px;scrollbar-width:thin;scrollbar-color:var(--line-2) transparent}
  .chats::-webkit-scrollbar{width:6px} .chats::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:999px}

  .chat-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:14px;cursor:pointer;transition:background .12s;animation:screenIn .2s}
  .chat-item:hover{background:var(--surface-2)}
  .chat-item .ava-wrap{width:48px;height:48px;margin:0 4px 4px 0} .chat-item .ava-wrap .ava{font-size:18px}
  .chat-item .ava-wrap .presence{width:11px;height:11px;right:-4px;bottom:-4px;border-width:2px}
  .chat-item .body{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .chat-item .row1{display:flex;align-items:center;gap:8px}
  .chat-item .name{font-weight:600;font-size:15px;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
  .chat-item .time{font-size:11px;color:var(--dim-2);font-family:var(--mono);flex-shrink:0}
  .chat-item .row2{display:flex;align-items:center;gap:8px}
  .chat-item .preview{font-size:13px;color:var(--dim);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
  .badge{min-width:20px;height:20px;padding:0 6px;border-radius:999px;background:var(--accent);color:var(--accent-ink);font-size:11px;font-weight:700;display:grid;place-items:center;flex-shrink:0;font-family:var(--mono)}
  .empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:48px 24px;text-align:center;color:var(--dim)}
  .empty .big{font-size:40px;opacity:.4} .empty p{font-size:13.5px;line-height:1.5;max-width:26ch}

  .chathead{display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--line);background:color-mix(in srgb, var(--surface) 60%, transparent);backdrop-filter:blur(20px) saturate(180%);flex-shrink:0;position:relative;z-index:2}
  .chathead .back{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:transparent;border:1px solid var(--line-2);color:var(--dim);cursor:pointer;transition:.15s;flex-shrink:0}
  .chathead .back:hover{color:var(--text);background:var(--surface-2)} .chathead .back svg{width:16px;height:16px}

  .ava-wrap{position:relative;width:40px;height:40px;flex-shrink:0;margin:0 5px 5px 0} .ava-wrap .ava{width:100%;height:100%}
  .ava{width:40px;height:40px;flex-shrink:0;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:16px;color:#fff;background:radial-gradient(circle at 30% 25%, rgba(255,255,255,.35), transparent 50%),linear-gradient(135deg, var(--accent), #a06bff);box-shadow:0 4px 14px color-mix(in srgb, var(--accent) 35%, transparent), inset 0 1px 0 rgba(255,255,255,.25);overflow:hidden;}
  .ava img{width:100%;height:100%;object-fit:cover}
  .presence{position:absolute;right:-5px;bottom:-5px;width:12px;height:12px;border-radius:50%;background:var(--ok);border:2px solid var(--bg-2);box-sizing:content-box;z-index:3;pointer-events:none;transition:background .2s,border-color .2s;box-shadow:0 1px 3px rgba(0,0,0,.35)}
  .presence.off{background:var(--dim-2)}

  .who{display:flex;flex-direction:column;gap:2px;min-width:0;flex:1}
  .who .n{font-weight:600;font-size:14.5px;letter-spacing:-.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .who .s{font-size:11.5px;color:var(--ok);font-weight:500}
  .leave{background:transparent;border:1px solid var(--line-2);color:var(--dim);font-size:12px;font-weight:600;padding:8px 12px;border-radius:var(--radius-sm);cursor:pointer;transition:.15s}
  .leave:hover{color:var(--danger);border-color:rgba(255,92,92,.4);background:rgba(255,92,92,.08)}

  .thread{flex:1;overflow-y:auto;padding:18px 16px 10px;display:flex;flex-direction:column;gap:8px;scrollbar-width:thin;scrollbar-color:var(--line-2) transparent;scroll-behavior:smooth}
  .thread::-webkit-scrollbar{width:6px} .thread::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:999px}
  .row{display:flex;animation:bubbleIn .22s cubic-bezier(.2,.7,.2,1)} @keyframes bubbleIn{from{opacity:0;transform:translateY(6px) scale(.98)}to{opacity:1;transform:none}}
  .row.me{justify-content:flex-end}
  .bubble{max-width:78%;font-size:14.5px;line-height:1.45;padding:10px 14px;border-radius:18px;position:relative;word-wrap:break-word;overflow-wrap:anywhere;box-shadow:var(--shadow-1)}
  .row.them .bubble{background:var(--surface-2);color:var(--text);border-bottom-left-radius:6px;border:1px solid var(--line)}
  .row.me .bubble{background:linear-gradient(180deg, var(--accent-2), var(--accent));color:var(--accent-ink);border-bottom-right-radius:6px;box-shadow:0 6px 18px color-mix(in srgb, var(--accent) 30%, transparent), inset 0 1px 0 rgba(255,255,255,.15)}
  .bubble .t{display:block;font-size:10px;font-weight:500;opacity:.6;margin-top:4px;text-align:right}
  .sys{align-self:center;font-size:11px;font-weight:500;color:var(--dim);background:var(--surface);border:1px solid var(--line);padding:5px 12px;border-radius:999px;margin:6px 0}
  .typing{align-self:flex-start;display:flex;gap:4px;align-items:center;padding:12px 16px;background:var(--surface-2);border:1px solid var(--line);border-radius:18px;border-bottom-left-radius:6px;width:fit-content;box-shadow:var(--shadow-1)}
  .typing i{width:6px;height:6px;border-radius:50%;background:var(--dim);animation:typingDot 1.3s infinite ease-in-out} .typing i:nth-child(2){animation-delay:.15s} .typing i:nth-child(3){animation-delay:.3s}
  @keyframes typingDot{0%,60%,100%{opacity:.35;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px);background:var(--accent-2)}}

  .composer{display:flex;gap:10px;align-items:flex-end;padding:12px 14px calc(12px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--line);background:color-mix(in srgb, var(--surface) 70%, transparent);backdrop-filter:blur(20px) saturate(180%);flex-shrink:0}
  .attach{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--surface);border:1px solid var(--line-2);color:var(--dim);cursor:pointer;transition:.15s;flex-shrink:0;}
  .attach:hover{color:var(--text);background:var(--surface-2)}
  .attach svg{width:20px;height:20px}
  .wrap{flex:1;position:relative}
  .composer input{margin:0;border-radius:22px;padding:12px 52px 12px 16px;background:var(--surface);font-size:15px}
  .count{position:absolute;right:14px;top:50%;transform:translateY(-50%);font-size:10.5px;font-weight:500;color:var(--dim-2);pointer-events:none;font-family:var(--mono);transition:color .15s}
  .count.warn{color:var(--danger)}
  .send{width:44px;height:44px;flex-shrink:0;display:grid;place-items:center;border-radius:50%;border:none;background:linear-gradient(180deg, var(--accent-2), var(--accent));color:var(--accent-ink);cursor:pointer;transition:filter .12s,opacity .12s;box-shadow:0 6px 18px color-mix(in srgb, var(--accent) 40%, transparent), inset 0 1px 0 rgba(255,255,255,.25)}
  .send:hover{filter:brightness(1.08)} .send:active{filter:brightness(.94)} .send:disabled{opacity:.35;cursor:not-allowed;filter:none;box-shadow:none}
  .send svg{width:18px;height:18px;display:block;transform:translateX(1px)}

  .settings-head{display:flex;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line);background:color-mix(in srgb, var(--surface) 60%, transparent);backdrop-filter:blur(20px) saturate(180%);flex-shrink:0;position:relative;z-index:2}
  .settings-head .title{font-weight:700;font-size:18px;letter-spacing:-.01em}
  .settings-head .back{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:transparent;border:1px solid var(--line-2);color:var(--dim);cursor:pointer;transition:.15s;flex-shrink:0}
  .settings-head .back:hover{color:var(--text);background:var(--surface-2)} .settings-head .back svg{width:16px;height:16px}

  .settings-body{flex:1;overflow-y:auto;padding:16px 16px 32px;display:flex;flex-direction:column;gap:16px;scrollbar-width:thin;scrollbar-color:var(--line-2) transparent}
  .settings-body::-webkit-scrollbar{width:6px} .settings-body::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:999px}

  .group{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);overflow:hidden; flex-shrink:0;}
  .group-title{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);padding:0 4px;font-family:var(--mono)}

  .rowitem{display:flex;align-items:center;gap:14px;padding:14px 16px;cursor:pointer;transition:background .12s;border-bottom:1px solid var(--line);min-height:56px;}
  .rowitem:last-child{border-bottom:none} .rowitem:hover{background:var(--surface-2)}
  .rowitem .ico{width:34px;height:34px;flex-shrink:0;border-radius:10px;display:grid;place-items:center;background:var(--surface-2);color:var(--accent)}
  .rowitem .ico svg{width:18px;height:18px}
  .rowitem .txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .rowitem .txt .t{font-size:15px;font-weight:500;color:var(--text);line-height:1.2;}
  .rowitem .txt .d{font-size:12.5px;color:var(--dim);line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .rowitem .chev{color:var(--dim-2);width:16px;height:16px;flex-shrink:0}

  .switch{position:relative;width:44px;height:26px;flex-shrink:0;background:var(--surface-3);border-radius:999px;cursor:pointer;transition:.2s;border:1px solid var(--line-2)}
  .switch::after{content:"";position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.3);transition:.2s cubic-bezier(.2,.7,.2,1)}
  .switch.on{background:var(--accent);border-color:var(--accent)} .switch.on::after{left:20px}

  .profile-hero{display:flex;flex-direction:column;align-items:center;gap:12px;padding:24px 16px;text-align:center}
  .avatar-lg-wrap{position:relative;width:88px;height:88px;margin:0 6px 6px 0} .avatar-lg-wrap .presence{width:16px;height:16px;right:-6px;bottom:-6px;border-width:3px}
  .avatar-lg{width:88px;height:88px;border-radius:50%;display:grid;place-items:center;font-weight:700;font-size:32px;color:#fff;background:radial-gradient(circle at 30% 25%, rgba(255,255,255,.35), transparent 50%),linear-gradient(135deg, var(--accent), #a06bff);box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 40%, transparent), inset 0 1px 0 rgba(255,255,255,.25);position:relative;cursor:pointer;overflow:hidden;transition:transform .15s}
  .avatar-lg:hover{transform:scale(1.03)} .avatar-lg img{width:100%;height:100%;object-fit:cover}
  .avatar-lg .edit{position:absolute;inset:auto 0 0 0;background:linear-gradient(transparent, rgba(0,0,0,.65));color:#fff;font-size:10px;font-weight:600;padding:20px 0 8px;letter-spacing:.04em;text-transform:uppercase}
  .profile-name{font-size:20px;font-weight:700;letter-spacing:-.02em} .profile-handle{font-size:13px;color:var(--dim);font-family:var(--mono)}

  .swatches{display:flex;gap:12px;padding:14px 16px;flex-wrap:wrap}
  .swatch{width:36px;height:36px;border-radius:50%;border:2px solid transparent;cursor:pointer;transition:transform .12s,border-color .12s;position:relative}
  .swatch:hover{transform:scale(1.08)} .swatch.active{border-color:var(--text);box-shadow:0 0 0 3px var(--surface)}
  .swatch.active::after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-weight:800;font-size:14px;text-shadow:0 1px 2px rgba(0,0,0,.5)}

  .segment{display:flex;gap:6px;padding:6px;background:var(--surface-2);border-radius:12px;margin:0 16px 14px}
  .segment button{flex:1;padding:10px 10px;border:none;border-radius:8px;background:transparent;color:var(--dim);font-size:13px;font-weight:600;cursor:pointer;transition:.15s;font-family:var(--sans)}
  .segment button.active{background:var(--surface);color:var(--text);box-shadow:var(--shadow-1)}

  .fontsize{display:flex;align-items:center;gap:12px;padding:0 16px 16px;} .fontsize input[type=range]{flex:1;accent-color:var(--accent);cursor:pointer}
  .group.danger-zone{border-color:rgba(255,92,92,.25)} .rowitem.danger .txt .t{color:var(--danger)} .rowitem.danger .ico{background:rgba(255,92,92,.12);color:var(--danger)} .rowitem.danger:hover{background:rgba(255,92,92,.06)}

  .modal-bg{position:absolute;inset:0;z-index:50;background:rgba(0,0,0,.55);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:24px;animation:fadeIn .2s}
  .modal-bg.open{display:flex} @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  .modal{width:100%;max-width:340px;background:var(--bg-2);border:1px solid var(--line-2);border-radius:var(--radius-lg);padding:22px;box-shadow:var(--shadow-3);animation:modalIn .25s cubic-bezier(.2,.7,.2,1)}
  @keyframes modalIn{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:none}}
  .modal h3{font-size:18px;font-weight:700;margin-bottom:8px} .modal p{font-size:14px;color:var(--dim);line-height:1.5;margin-bottom:18px}
  .modal .actions{display:flex;gap:10px;flex-direction:column}
  .toast{position:absolute;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);background:var(--surface-3);color:var(--text);padding:12px 20px;border-radius:999px;font-size:13px;font-weight:500;box-shadow:var(--shadow-2);border:1px solid var(--line-2);opacity:0;pointer-events:none;transition:.25s;z-index:100;white-space:nowrap}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

  @media (max-width:480px){ .app{max-width:100%; height:100dvh;} .form { max-width:100%; padding:0 16px; } }
</style>
</head>
<body>
<div class="app" id="app">

  <div class="push-sms" id="push-sms">
    <div class="push-ico">Z</div>
    <div class="push-body">
      <div class="push-title">Zuno Code <span>сейчас</span></div>
      <div class="push-phone" id="push-phone-val">+7 ...</div>
      <div class="push-text">Код: <span class="push-code" id="push-code-val">0000</span></div>
    </div>
  </div>

  <div class="topbar">
    <span class="dot off" id="dot"></span>
    <span class="brand">Zuno <span>· demo</span></span>
    <span class="spacer"></span>
    <span id="status-label">offline</span>
    <button class="icon-btn" id="open-settings" aria-label="Настройки" style="margin-left:10px">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
    </button>
  </div>

  <!-- 1. phone -->
  <section class="screen active" id="s-phone">
    <div class="form">
      <div>
        <div class="kicker">Шаг 01 — вход</div>
        <h1>Ваш номер <span class="thin">телефона</span></h1>
      </div>
      <p class="hint">Введите реальный номер. Мы проверим его по маске страны и отправим СМС.</p>
      <div class="field">
        <label class="label" for="phone">Номер</label>
        <input id="phone" type="tel" placeholder="+7 999 123 45 67" autocomplete="tel" inputmode="tel">
        <div class="feedback" id="fb-phone"></div>
      </div>
      <button class="btn" id="go-code">Получить код</button>
      <div class="foot"><span>zuno</span><span class="sep"></span><span>v1.3</span><span class="sep"></span><span>прайм</span></div>
    </div>
  </section>

  <!-- 2. code -->
  <section class="screen" id="s-code">
    <div class="form">
      <div>
        <div class="kicker">Шаг 02 — проверка</div>
        <h1>Введите <span class="thin">код</span></h1>
      </div>
      <p class="hint">Отправили СМС на <b id="phone-view">—</b>. <span id="fake-resend" style="color:var(--accent);cursor:pointer;text-decoration:underline;text-underline-offset:3px">Отправить повторно</span></p>
      <div class="otp" id="otp">
        <input type="text" inputmode="numeric" maxlength="1" aria-label="цифра 1">
        <input type="text" inputmode="numeric" maxlength="1" aria-label="цифра 2">
        <input type="text" inputmode="numeric" maxlength="1" aria-label="цифра 3">
        <input type="text" inputmode="numeric" maxlength="1" aria-label="цифра 4">
      </div>
      <div class="feedback" id="fb-code"></div>
      <button class="btn" id="verify">Подтвердить</button>
      <button class="btn ghost" id="back">Изменить номер</button>
      <div class="foot" id="code-hint"></div>
    </div>
  </section>

  <!-- 3. chats list -->
  <section class="screen" id="s-list">
    <div class="list-head">
      <div class="title">Чаты</div>
    </div>
    <div class="search">
      <div class="wrap-search">
        <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search-input" type="text" placeholder="Поиск чатов…" autocomplete="off">
      </div>
    </div>
    <div class="chats" id="chats"></div>
  </section>

  <!-- 4. chat -->
  <section class="screen" id="s-chat">
    <div class="chathead">
      <button class="back" id="chat-back" aria-label="Назад">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="ava-wrap">
        <div class="ava" id="chat-ava">Z</div>
        <span class="presence" id="chat-presence"></span>
      </div>
      <div class="who">
        <div class="n" id="chat-name">Zuno Bot</div>
        <div class="s" id="chat-status">в сети</div>
      </div>
      <button class="leave" id="logout">Выйти</button>
    </div>
    <div class="thread" id="thread"></div>
    <div class="composer">
      <button class="attach" id="attach-btn" aria-label="Прикрепить">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
      </button>
      <div class="wrap">
        <input id="msg" type="text" placeholder="Сообщение…" autocomplete="off" maxlength="500">
        <span class="count" id="count">0/500</span>
      </div>
      <button class="send" id="send" aria-label="Отправить" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
      </button>
    </div>
  </section>

  <!-- 5. settings -->
  <section class="screen" id="s-settings">
    <div class="settings-head">
      <button class="back" id="settings-back" aria-label="Назад">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <span class="title">Настройки</span>
    </div>
    <div class="settings-body">

      <div class="group">
        <div class="profile-hero">
          <div class="avatar-lg-wrap">
            <label class="avatar-lg" id="avatar-lg" for="avatar-input" title="Сменить аватар">
              <span id="avatar-fallback">U</span>
              <img id="avatar-img" alt="" style="display:none">
              <span class="edit">изменить</span>
            </label>
            <span class="presence" id="profile-presence"></span>
          </div>
          <input type="file" id="avatar-input" accept="image/*" style="display:none">
          <div class="profile-name" id="profile-name">Пользователь</div>
          <div class="profile-handle" id="profile-handle">@user</div>
        </div>
      </div>

      <div class="group">
        <div class="rowitem" data-edit="name">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
          <div class="txt"><span class="t">Имя</span><span class="d" id="val-name">Пользователь</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="rowitem" data-edit="handle">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"/></svg></div>
          <div class="txt"><span class="t">Имя пользователя</span><span class="d" id="val-handle">@user</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="rowitem" data-edit="bio">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H5.17L4 17.17V4Z"/></svg></div>
          <div class="txt"><span class="t">О себе</span><span class="d" id="val-bio">—</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="rowitem" data-edit="phone">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg></div>
          <div class="txt"><span class="t">Телефон</span><span class="d" id="val-phone">—</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
      </div>

      <div class="group-title">Конфиденциальность</div>
      <div class="group">
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
          <div class="txt"><span class="t">Последний визит</span><span class="d">Показывать «был(а) недавно»</span></div>
          <div class="switch on" data-toggle="lastSeen"></div>
        </div>
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg></div>
          <div class="txt"><span class="t">Статус «в сети»</span><span class="d">Показывать, когда вы онлайн</span></div>
          <div class="switch on" data-toggle="online"></div>
        </div>
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
          <div class="txt"><span class="t">«Печатает…»</span><span class="d">Показывать, когда вы набираете</span></div>
          <div class="switch on" data-toggle="typing"></div>
        </div>
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
          <div class="txt"><span class="t">Шифрование</span><span class="d">Сквозное шифрование (демо)</span></div>
          <div class="switch on" data-toggle="e2e"></div>
        </div>
        <div class="rowitem" id="who-can-write">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg></div>
          <div class="txt"><span class="t">Кто может писать</span><span class="d" id="val-who-can-write">Все</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="rowitem" id="blocklist">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></div>
          <div class="txt"><span class="t">Заблокированные</span><span class="d" id="val-blocked">0 контактов</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
      </div>

      <div class="group-title">Уведомления</div>
      <div class="group">
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
          <div class="txt"><span class="t">Уведомления</span><span class="d">Показывать оповещения</span></div>
          <div class="switch on" data-toggle="notif"></div>
        </div>
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg></div>
          <div class="txt"><span class="t">Звук</span><span class="d">Звук новых сообщений</span></div>
          <div class="switch on" data-toggle="sound"></div>
        </div>
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg></div>
          <div class="txt"><span class="t">Вибрация</span><span class="d">Короткая вибрация</span></div>
          <div class="switch on" data-toggle="vibration"></div>
        </div>
        <div class="rowitem">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="m2 2 20 20"/></svg></div>
          <div class="txt"><span class="t">Не беспокоить</span><span class="d">Отключить все оповещения</span></div>
          <div class="switch" data-toggle="dnd"></div>
        </div>
      </div>

      <div class="group-title">Внешний вид</div>
      <div class="group">
        <div class="rowitem" style="border-bottom:none;padding-bottom:6px">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg></div>
          <div class="txt"><span class="t">Тема</span><span class="d">Тёмная или светлая</span></div>
        </div>
        <div class="segment" id="theme-seg">
          <button data-theme-val="dark" class="active">Тёмная</button>
          <button data-theme-val="light">Светлая</button>
        </div>
        <div class="rowitem" style="border-bottom:none;padding-bottom:6px">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="10.5" r="2.5"/><circle cx="8.5" cy="7.5" r="2.5"/><circle cx="6.5" cy="12.5" r="2.5"/><path d="M12 22a10 10 0 1 1 0-20 10 10 0 0 1 0 20Z"/></svg></div>
          <div class="txt"><span class="t">Акцент</span><span class="d">Цвет интерфейса</span></div>
        </div>
        <div class="swatches" id="accent-swatches">
          <div class="swatch active" data-accent-val="blue" style="background:#5b8cff"></div>
          <div class="swatch" data-accent-val="violet" style="background:#a06bff"></div>
          <div class="swatch" data-accent-val="lime" style="background:#8bd000"></div>
          <div class="swatch" data-accent-val="pink" style="background:#ff5c9d"></div>
          <div class="swatch" data-accent-val="orange" style="background:#ff8a3d"></div>
          <div class="swatch" data-accent-val="cyan" style="background:#22c8d8"></div>
        </div>
        <div class="rowitem" style="border-bottom:none;padding-bottom:0">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg></div>
          <div class="txt"><span class="t">Размер текста</span><span class="d" id="val-fontsize">100%</span></div>
        </div>
        <div class="fontsize">
          <input type="range" id="fontrange" min="85" max="125" step="5" value="100">
        </div>
      </div>

      <div class="group-title">Данные</div>
      <div class="group">
        <div class="rowitem" id="export-data">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></div>
          <div class="txt"><span class="t">Экспорт данных</span><span class="d">Скачать переписку и настройки</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="rowitem" id="clear-chat">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="m19 6-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg></div>
          <div class="txt"><span class="t">Очистить переписку</span><span class="d">Удалить все сообщения</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <div class="rowitem" id="reset-settings">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></div>
          <div class="txt"><span class="t">Сбросить настройки</span><span class="d">Вернуть значения по умолчанию</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
      </div>

      <div class="group-title">Опасная зона</div>
      <div class="group danger-zone">
        <div class="rowitem danger" id="delete-account">
          <div class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></div>
          <div class="txt"><span class="t">Удалить аккаунт</span><span class="d">Безвозвратно удалить все данные</span></div>
          <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </div>
      </div>

      <div class="foot" style="justify-content:center;margin-top:16px"><span>zuno</span><span class="sep"></span><span>v1.3</span><span class="sep"></span><span>сборка 2025</span></div>
    </div>
  </section>

  <div class="modal-bg" id="modal-bg">
    <div class="modal" id="modal">
      <h3 id="modal-title">Заголовок</h3>
      <p id="modal-text">Текст</p>
      <div class="field" id="modal-field" style="display:none;margin-bottom:16px">
        <input id="modal-input" type="text" placeholder="">
        <div class="feedback" id="modal-fb"></div>
      </div>
      <div class="actions" id="modal-actions"></div>
    </div>
  </div>

  <div class="toast" id="toast"></div>
</div>

<script>
(() => {
  "use strict";

  const $ = id => document.getElementById(id);
  const LS = {
    key:"zuno.prime.v3",
    load(){try{return JSON.parse(localStorage.getItem(this.key))||{}}catch{return{}}},
    save(o){try{localStorage.setItem(this.key,JSON.stringify(o))}catch{}},
    clear(){try{localStorage.removeItem(this.key)}catch{}}
  };

  const CHATS = [
    { id:"bot",   name:"Zuno Bot",     handle:"@zuno_bot",   avatar:"Z", online:true,  color:"var(--accent)" },
    { id:"alice", name:"Алиса",        handle:"@alice",      avatar:"А", online:true,  color:"#ff5c9d" },
    { id:"max",   name:"Макс",         handle:"@max",        avatar:"М", online:false, color:"#22c8d8" },
    { id:"team",  name:"Команда",      handle:"@team",       avatar:"К", online:true,  color:"#8bd000" }
  ];

  const defaults = {
    phone:null, code:null,
    chats:{},
    profile:{ name:"Пользователь", handle:"@user", bio:"", avatar:null },
    prefs:{
      lastSeen:true, online:true, typing:true, e2e:true,
      notif:true, sound:true, vibration:true, dnd:false,
      whoCanWrite:"Все", blocked:[],
      theme:"dark", accent:"blue", fontScale:100
    }
  };

  let state = structuredClone(defaults);
  const saved = LS.load();
  if (saved && typeof saved === "object") {
    state = Object.assign(structuredClone(defaults), saved);
    state.profile = Object.assign(structuredClone(defaults.profile), saved.profile||{});
    state.prefs   = Object.assign(structuredClone(defaults.prefs),   saved.prefs||{});
    state.chats   = Object.assign({}, saved.chats||{});
  }
  const persist = () => LS.save(state);

  const digits = v => (v||"").replace(/\D/g,"");
  const nowTime = () => new Date().toLocaleTimeString("ru-RU",{hour:"2-digit",minute:"2-digit"});
  const esc = s => s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  const chatMeta = id => CHATS.find(c=>c.id===id) || CHATS[0];
  const ensureChat = id => {
    if(!state.chats[id]) state.chats[id] = { messages:[], unread:0, lastTs:null };
    return state.chats[id];
  };
  const lastMessage = id => {
    const c = state.chats[id];
    return c && c.messages.length ? c.messages[c.messages.length-1] : null;
  };

  const show = id => {
    document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
    $(id).classList.add("active");
  };
  const setStatus = online => {
    $("status-label").textContent = online ? "online" : "offline";
    $("dot").classList.toggle("off", !online);
  };

  // ЖЁСТКАЯ ВАЛИДАЦИЯ НОМЕРА (локальные маски)
  function validatePhone(phoneStr) {
    const d = digits(phoneStr);
    // Все шестёрки или одинаковые символы — отказ
    if (/^(\d)\1+$/.test(d)) return false;
    
    // Маски для основных стран (код страны: [min_len, max_len])
    const countries = {
      "7": [11, 11],  // Россия/Казахстан
      "1": [10, 10],  // США/Канада
      "44": [10, 10], // Великобритания
      "49": [10, 11], // Германия
      "33": [9, 9],   // Франция
      "380": [11, 11],// Украина
      "375": [11, 11],// Беларусь
      "998": [9, 9],  // Узбекистан
      "77": [11, 11], // Казахстан (иногда)
    };

    let matched = false;
    for (const [code, len] of Object.entries(countries)) {
      if (d.startsWith(code)) {
        if (d.length >= len[0] && d.length <= len[1]) {
          matched = true;
          break;
        }
      }
    }
    
    if (!matched) return false;

    // Проверка на реальные префиксы операторов РФ (9xx)
    if (d.startsWith("7")) {
      const operatorCode = d.substring(1, 4); // 999, 900 и т.д.
      if (["900","901","902","903","904","905","906","908","909","910","911","912","913","914","915","916","917","918","919","920","921","922","923","924","925","926","927","928","929","930","931","932","933","934","936","937","938","939","950","951","952","953","954","955","956","958","960","961","962","963","964","965","966","967","968","969","980","981","982","983","984","985","986","987","988","989","999"].indexOf(operatorCode) === -1) {
        return false; // Неизвестный оператор
      }
    }

    return true;
  }

  function applyTheme(){
    document.documentElement.setAttribute("data-theme", state.prefs.theme);
    document.documentElement.setAttribute("data-accent", state.prefs.accent);
    document.documentElement.style.setProperty("--font-scale", state.prefs.fontScale/100);
    document.querySelectorAll("#theme-seg button").forEach(b=>{
      b.classList.toggle("active", b.dataset.themeVal === state.prefs.theme);
    });
    document.querySelectorAll("#accent-swatches .swatch").forEach(s=>{
      s.classList.toggle("active", s.dataset.accentVal === state.prefs.accent);
    });
    $("fontrange").value = state.prefs.fontScale;
    $("val-fontsize").textContent = state.prefs.fontScale + "%";
  }

  let toastTimer=null;
  function toast(msg){
    const t=$("toast"); t.textContent=msg; t.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer=setTimeout(()=>t.classList.remove("show"),2000);
  }

  const modal = {
    open(opts){
      $("modal-title").textContent = opts.title || "";
      $("modal-text").textContent = opts.text || "";
      $("modal-text").style.display = opts.text ? "block" : "none";
      $("modal-fb").textContent = "";
      $("modal-fb").className = "feedback";
      const field = $("modal-field");
      if (opts.input !== undefined){
        field.style.display = "flex";
        $("modal-input").value = opts.input.value ?? "";
        $("modal-input").type = opts.input.type || "text";
        $("modal-input").placeholder = opts.input.placeholder || "";
        setTimeout(()=>$("modal-input").focus(),50);
      } else field.style.display = "none";

      const actions=$("modal-actions"); actions.innerHTML="";
      (opts.actions||[]).forEach(a=>{
        const b=document.createElement("button");
        b.className="btn " + (a.style||"");
        b.textContent=a.label;
        b.onclick=()=>a.onClick && a.onClick(closeModal);
        actions.appendChild(b);
      });
      $("modal-bg").classList.add("open");
    }
  };
  function closeModal(){ $("modal-bg").classList.remove("open"); }
  $("modal-bg").addEventListener("click", e => { if (e.target.id === "modal-bg") closeModal(); });

  // --- НАСТОЯЩИЙ PUSH С ВИБРАЦИЕЙ И ЗВУКОМ ---
  async function sendRealPush(phone, code) {
    // Визуальная плашка
    $("push-phone-val").textContent = phone;
    $("push-code-val").textContent = code;
    $("push-sms").classList.add("show");
    setTimeout(() => $("push-sms").classList.remove("show"), 8000);

    // Вибрация (работает на телефонах)
    if ("vibrate" in navigator) {
      navigator.vibrate([200, 100, 200, 100, 200]);
    }

    // Звук (используем AudioContext для простого бипа)
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      const oscillator = audioCtx.createOscillator();
      const gainNode = audioCtx.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
      gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
      gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.5);
      oscillator.connect(gainNode);
      gainNode.connect(audioCtx.destination);
      oscillator.start();
      oscillator.stop(audioCtx.currentTime + 0.5);
    } catch (e) {}

    // Системное уведомление
    if (!("Notification" in window)) return;
    try {
      let permission = Notification.permission;
      if (permission === "default") permission = await Notification.requestPermission();
      if (permission === "granted") {
        new Notification("Zuno Code", {
          body: `СМС на номер ${phone}\nКод: ${code}`,
          vibrate: [200, 100, 200]
        });
      }
    } catch (e) {}
  }

  // --- Вход ---
  $("phone").addEventListener("input", e => {
    let d = digits(e.target.value).slice(0,15);
    if (!d){ e.target.value=""; return; }
    if (d[0]==="7" && d.length>1){
      const p=d.slice(1); let out="+7";
      if(p.length)  out+=" "+p.slice(0,3);
      if(p.length>3)out+=" "+p.slice(3,6);
      if(p.length>6)out+=" "+p.slice(6,8);
      if(p.length>8)out+=" "+p.slice(8,10);
      e.target.value=out;
    } else e.target.value="+"+d;
    e.target.classList.remove("error");
    $("fb-phone").textContent="";
  });

  $("go-code").addEventListener("click", () => {
    const raw=$("phone").value, fb=$("fb-phone");
    
    if (!validatePhone(raw)) {
      $("phone").classList.add("error");
      fb.textContent="Неверный номер (проверьте код оператора и длину)";
      fb.className="feedback err";
      $("phone").focus();
      return;
    }

    let d = digits(raw);
    if (d.startsWith("7")) d = "+" + d;
    else d = "+" + d;
    
    state.phone = d;
    state.code = String(Math.floor(1000+Math.random()*9000));
    persist();
    
    $("phone-view").textContent = state.phone;
    $("code-hint").innerHTML='<span>demo</span><span class="sep"></span><span>код: '+state.code+'</span>';
    $("fb-code").textContent="";
    $("fb-code").className="feedback";
    document.querySelectorAll("#otp input").forEach(i=>{i.value="";i.classList.remove("error","filled")});
    
    sendRealPush(state.phone, state.code);
    
    show("s-code");
    setTimeout(()=>document.querySelector("#otp input").focus(),80);
  });

  $("phone").addEventListener("keydown",e=>{if(e.key==="Enter")$("go-code").click()});

  const otpInputs=[...document.querySelectorAll("#otp input")];
  otpInputs.forEach((inp,i)=>{
    inp.addEventListener("input",()=>{
      inp.value=inp.value.replace(/\D/g,"").slice(0,1);
      inp.classList.toggle("filled",!!inp.value);
      if(inp.value&&i<otpInputs.length-1)otpInputs[i+1].focus();
      if(otpInputs.every(x=>x.value))$("verify").focus();
    });
    inp.addEventListener("keydown",e=>{
      if(e.key==="Backspace"&&!inp.value&&i>0){otpInputs[i-1].focus();otpInputs[i-1].value="";otpInputs[i-1].classList.remove("filled")}
      if(e.key==="ArrowLeft"&&i>0)otpInputs[i-1].focus();
      if(e.key==="ArrowRight"&&i<otpInputs.length-1)otpInputs[i+1].focus();
      if(e.key==="Enter")$("verify").click();
    });
    inp.addEventListener("paste",e=>{
      e.preventDefault();
      const t=digits((e.clipboardData||window.clipboardData).getData("text")).slice(0,4);
      [...t].forEach((ch,j)=>{if(otpInputs[j]){otpInputs[j].value=ch;otpInputs[j].classList.add("filled")}});
      (otpInputs[Math.min(t.length,3)]||otpInputs[3]).focus();
    });
  });

  $("verify").addEventListener("click",()=>{
    const entered=otpInputs.map(i=>i.value).join("");
    const fb=$("fb-code");
    
    if(entered.length!==4){ 
      fb.textContent="Введите все 4 цифры"; 
      fb.className="feedback err"; 
      return; 
    }
    
    if(entered!==state.code){
      otpInputs.forEach(i=>i.classList.add("error"));
      fb.textContent="Неверный код. Проверьте, на тот ли номер он пришёл."; 
      fb.className="feedback err"; 
      return;
    }
    
    otpInputs.forEach(i=>i.classList.remove("error"));
    fb.textContent="Готово, входим…"; fb.className="feedback ok";
    $("verify").disabled=true;
    setTimeout(()=>{ $("verify").disabled=false; enterApp(); },420);
  });

  $("back").addEventListener("click",()=>{ 
    state.code = null; 
    persist();
    show("s-phone"); 
    setStatus(false); 
    $("phone").focus(); 
  });

  $("fake-resend").addEventListener("click",()=>{
    state.code=String(Math.floor(1000+Math.random()*9000)); persist();
    $("code-hint").innerHTML='<span>demo</span><span class="sep"></span><span>новый код: '+state.code+'</span>';
    $("fb-code").textContent="Код обновлён"; $("fb-code").className="feedback ok";
    sendRealPush(state.phone, state.code);
  });

  // --- Приложение ---
  function enterApp(){
    setStatus(true);
    show("s-list");
    renderChats();
    refreshProfileUI();
  }

  // --- Список чатов ---
  function renderChats(){
    const container = $("chats");
    const q = ($("search-input").value || "").trim().toLowerCase();
    container.innerHTML = "";

    const items = CHATS
      .map(c => ({ c, last: lastMessage(c.id), chat: state.chats[c.id] }))
      .filter(({c}) => !q || c.name.toLowerCase().includes(q) || c.handle.toLowerCase().includes(q));

    if (!items.length){
      container.innerHTML = '<div class="empty"><div class="big">💬</div><p>Пока нет чатов. Начните с Zuno Bot.</p></div>';
      return;
    }

    items.sort((a,b)=>{
      const ua = (a.chat && a.chat.unread) ? 1 : 0;
      const ub = (b.chat && b.chat.unread) ? 1 : 0;
      if (ua !== ub) return ub - ua;
      const ta = a.last ? a.last.ts : "";
      const tb = b.last ? b.last.ts : "";
      return tb.localeCompare(ta);
    });

    items.forEach(({c, last, chat}) => {
      const el = document.createElement("div");
      el.className = "chat-item";
      el.dataset.id = c.id;
      el.onclick = () => openChat(c.id);

      const preview = last
        ? (last.who==="me" ? "Вы: " : "") + (last.isImg ? "Изображение" : esc(last.text))
        : (chat && chat.messages.length ? "" : "Нет сообщений");
      const time = last ? last.ts : "";
      const unread = chat && chat.unread ? chat.unread : 0;

      el.innerHTML = `
        <div class="ava-wrap">
          <div class="ava" style="background:radial-gradient(circle at 30% 25%, rgba(255,255,255,.35), transparent 50%),linear-gradient(135deg, ${c.color}, #a06bff)">${esc(c.avatar)}</div>
          <span class="presence ${c.online ? "" : "off"}"></span>
        </div>
        <div class="body">
          <div class="row1">
            <div class="name">${esc(c.name)}</div>
            <div class="time">${time}</div>
          </div>
          <div class="row2">
            <div class="preview">${preview}</div>
            ${unread ? `<div class="badge">${unread}</div>` : ""}
          </div>
        </div>
      `;
      container.appendChild(el);
    });
  }

  $("search-input").addEventListener("input", renderChats);

  // --- Чат ---
  let currentChatId = null;

  function openChat(id){
    currentChatId = id;
    const meta = chatMeta(id);
    const chat = ensureChat(id);

    if (chat.unread) chat.unread = 0;
    persist();

    $("chat-name").textContent = meta.name;
    $("chat-status").textContent = meta.online ? "в сети" : "был(а) недавно";
    $("chat-ava").innerHTML = esc(meta.avatar);
    $("chat-presence").classList.toggle("off", !meta.online || !state.prefs.online);

    if (!chat.messages.length && id === "bot"){
      pushToChat(id, "them", "Привет. Это Zuno — демо-канал.");
      pushToChat(id, "sys",  "соединение установлено");
      setTimeout(()=>pushToChat(id, "them", "Напиши что-нибудь — проверю, как работает."),700);
    }

    renderThread();
    show("s-chat");
    setTimeout(()=>$("msg").focus(),100);
  }

  $("chat-back").addEventListener("click",()=>{
    currentChatId = null;
    show("s-list");
    renderChats();
  });

  function renderThread(){
    const t = $("thread");
    t.innerHTML = "";
    if (!currentChatId) return;
    const chat = ensureChat(currentChatId);
    chat.messages.forEach(m=>appendBubble(m, currentChatId));
    t.scrollTop = t.scrollHeight;
  }

  function appendBubble(m, chatId){
    const t = $("thread");
    if (m.who === "sys"){
      const el = document.createElement("div");
      el.className = "sys"; el.textContent = m.text; t.appendChild(el);
    } else {
      const row = document.createElement("div");
      row.className = "row " + (m.who === "me" ? "me" : "them");
      const b = document.createElement("div");
      b.className = "bubble";
      if (m.isImg) {
        b.innerHTML = `<img src="${m.text}" style="max-width:100%;border-radius:10px;display:block;margin-bottom:4px"><span class="t">${m.ts}</span>`;
      } else {
        b.innerHTML = esc(m.text) + '<span class="t">' + m.ts + "</span>";
      }
      row.appendChild(b); t.appendChild(row);
    }
    t.scrollTop = t.scrollHeight;
  }

  function pushToChat(chatId, who, text, isImg=false){
    const chat = ensureChat(chatId);
    const m = { who, text, isImg, ts: nowTime() };
    chat.messages.push(m);
    chat.lastTs = m.ts;
    if (who !== "me" && chatId !== currentChatId) chat.unread = (chat.unread||0) + 1;
    persist();
    if (chatId === currentChatId) appendBubble(m, chatId);
    if ($("s-list").classList.contains("active")) renderChats();
    return m;
  }

  let typingEl = null;
  function showTyping(){
    if (typingEl) return;
    typingEl = document.createElement("div");
    typingEl.className = "typing";
    typingEl.innerHTML = "<i></i><i></i><i></i>";
    $("thread").appendChild(typingEl);
    $("thread").scrollTop = $("thread").scrollHeight;
  }
  function hideTyping(){ if (typingEl){ typingEl.remove(); typingEl = null; } }

  const replies = ["Принял 👍","Ага, понятно","Звучит логично","Давай проверим ещё раз","Zuno на связи ⚡","Интересно, расскажи подробнее","Ок, записал"];
  function botRespond(chatId){
    if (state.prefs.dnd) return;
    showTyping();
    setTimeout(()=>{
      hideTyping();
      pushToChat(chatId, "them", replies[Math.floor(Math.random()*replies.length)]);
    }, 600 + Math.random()*900);
  }

  function sendMsg(){
    if (!currentChatId) return;
    const inp = $("msg");
    const text = inp.value.trim();
    if (!text) return;
    pushToChat(currentChatId, "me", text);
    inp.value = ""; updateCount();
    if (currentChatId === "bot") botRespond(currentChatId);
  }

  $("send").addEventListener("click", sendMsg);
  $("msg").addEventListener("keydown", e => { if (e.key === "Enter") sendMsg(); });

  // Отправка картинки
  $("attach-btn").addEventListener("click", () => {
    if (!currentChatId) return;
    const input = document.createElement("input");
    input.type = "file"; input.accept = "image/*";
    input.onchange = e => {
      const file = e.target.files[0]; if(!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        pushToChat(currentChatId, "me", ev.target.result, true);
        if (currentChatId === "bot") setTimeout(()=>pushToChat(currentChatId, "them", "Классная картинка! 📸"), 1000);
      };
      reader.readAsDataURL(file);
    };
    input.click();
  });

  function updateCount(){
    const n = $("msg").value.length;
    const c = $("count");
    c.textContent = n + "/500";
    c.classList.toggle("warn", n > 450);
    $("send").disabled = n === 0;
  }
  $("msg").addEventListener("input", updateCount);

  $("logout").addEventListener("click", ()=>{
    state.phone = null; state.code = null; state.chats = {};
    persist();
    currentChatId = null;
    setStatus(false);
    show("s-phone");
    $("phone").value = ""; $("fb-phone").textContent = "";
    $("phone").focus();
  });

  // --- Настройки ---
  $("open-settings").addEventListener("click", ()=>{
    show("s-settings"); renderSettings();
  });
  $("settings-back").addEventListener("click", ()=>{
    if (state.phone && state.chats && Object.keys(state.chats).length) show("s-list");
    else if (state.phone) show("s-list");
    else show("s-phone");
    renderChats();
  });

  function refreshProfileUI(){
    const p = state.profile;
    const initial = (p.name||"U").trim().charAt(0).toUpperCase() || "U";
    $("profile-name").textContent = p.name || "Пользователь";
    $("profile-handle").textContent = p.handle || "@user";
    $("val-name").textContent = p.name || "—";
    $("val-handle").textContent = p.handle || "—";
    $("val-bio").textContent = p.bio || "—";
    $("val-phone").textContent = state.phone || "—";

    if (p.avatar){
      $("avatar-img").src = p.avatar; $("avatar-img").style.display = "block";
      $("avatar-fallback").style.display = "none";
    } else {
      $("avatar-img").style.display = "none";
      $("avatar-fallback").style.display = "inline";
      $("avatar-fallback").textContent = initial;
    }
    const pp = $("profile-presence");
    if (pp) pp.classList.toggle("off", !state.prefs.online);
  }

  function renderSettings(){
    document.querySelectorAll(".switch[data-toggle]").forEach(sw=>{
      const k = sw.dataset.toggle;
      sw.classList.toggle("on", !!state.prefs[k]);
    });
    $("val-who-can-write").textContent = state.prefs.whoCanWrite || "Все";
    $("val-blocked").textContent = (state.prefs.blocked.length||0) + " контактов";
    applyTheme();
    refreshProfileUI();
  }

  document.querySelectorAll(".switch[data-toggle]").forEach(sw=>{
    sw.addEventListener("click", ()=>{
      const k = sw.dataset.toggle;
      state.prefs[k] = !state.prefs[k];
      sw.classList.toggle("on", state.prefs[k]);
      persist();
      if (k === "online"){
        $("profile-presence").classList.toggle("off", !state.prefs.online);
        $("chat-presence").classList.toggle("off", !state.prefs.online);
      }
      toast((state.prefs[k]?"Вкл: ":"Выкл: ") + labelFor(k));
    });
  });
  function labelFor(k){
    return ({lastSeen:"последний визит",online:"статус онлайн",typing:"«печатает…»",e2e:"шифрование",notif:"уведомления",sound:"звук",vibration:"вибрация",dnd:"не беспокоить"})[k] || k;
  }

  document.querySelectorAll("[data-edit]").forEach(row=>{
    row.addEventListener("click", ()=>{
      const key = row.dataset.edit;
      if (key === "phone"){
        modal.open({
          title:"Сменить номер",
          text:"Введите новый номер телефона.",
          input:{value:state.phone||"", placeholder:"+7 999 123 45 67", type:"tel"},
          actions:[
            {label:"Отмена", style:"ghost", onClick:closeModal},
            {label:"Сохранить", onClick:(close)=>{
              const v = $("modal-input").value.trim();
              if(!validatePhone(v)){ $("modal-fb").textContent="Некорректный номер"; $("modal-fb").className="feedback err"; return; }
              state.phone = "+" + digits(v); persist(); refreshProfileUI(); close(); toast("Номер обновлён");
            }}
          ]
        });
        return;
      }
      const labels = { name:"Имя", handle:"Имя пользователя", bio:"О себе" };
      const current = state.profile[key] || "";
      modal.open({
        title: labels[key],
        text: key === "handle" ? "Начните с @, только латиница, цифры и _." : "",
        input:{ value: current, placeholder: labels[key], type:"text" },
        actions:[
          {label:"Отмена", style:"ghost", onClick:closeModal},
          {label:"Сохранить", onClick:(close)=>{
            let v = $("modal-input").value.trim();
            if (key === "handle"){
              v = v ? (v.startsWith("@")?v:"@"+v) : "@user";
              if(!/^@[a-zA-Z0-9_]{2,20}$/.test(v)){ $("modal-fb").textContent="Формат: @username"; $("modal-fb").className="feedback err"; return; }
            }
            if (key === "name" && !v){ $("modal-fb").textContent="Имя не может быть пустым"; $("modal-fb").className="feedback err"; return; }
            state.profile[key] = v; persist(); refreshProfileUI(); close(); toast("Сохранено");
          }}
        ]
      });
    });
  });

  $("avatar-input").addEventListener("change", e => {
    const file = e.target.files[0]; if(!file) return;
    if (file.size > 2*1024*1024){ toast("Файл больше 2 МБ"); return; }
    const reader = new FileReader();
    reader.onload = ()=>{ state.profile.avatar = reader.result; persist(); refreshProfileUI(); toast("Аватар обновлён"); };
    reader.readAsDataURL(file);
  });

  $("who-can-write").addEventListener("click", ()=>{
    const opts = ["Все","Мои контакты","Никто"];
    modal.open({
      title:"Кто может писать",
      text:"Ограничьте, кто может начинать с вами диалог.",
      actions: opts.map(o=>({
        label:(state.prefs.whoCanWrite===o?"✓ ":"")+o,
        style: state.prefs.whoCanWrite===o ? "" : "ghost",
        onClick:(close)=>{ state.prefs.whoCanWrite=o; persist(); $("val-who-can-write").textContent=o; close(); toast("Сохранено"); }
      }))
    });
  });

  $("blocklist").addEventListener("click", ()=>{
    modal.open({
      title:"Заблокированные",
      text: state.prefs.blocked.length ? "Список: "+state.prefs.blocked.join(", ") : "Список пуст.",
      input:{value:"", placeholder:"@username или номер", type:"text"},
      actions:[
        {label:"Закрыть", style:"ghost", onClick:closeModal},
        {label:"Заблокировать", onClick:(close)=>{
          const v = $("modal-input").value.trim(); if(!v) return;
          state.prefs.blocked.push(v); persist();
          $("val-blocked").textContent = state.prefs.blocked.length + " контактов";
          close(); toast("Заблокирован: "+v);
        }}
      ]
    });
  });

  document.querySelectorAll("#theme-seg button").forEach(b=>{
    b.addEventListener("click",()=>{ state.prefs.theme = b.dataset.themeVal; persist(); applyTheme(); });
  });
  document.querySelectorAll("#accent-swatches .swatch").forEach(s=>{
    s.addEventListener("click",()=>{ state.prefs.accent = s.dataset.accentVal; persist(); applyTheme(); });
  });
  $("fontrange").addEventListener("input", e=>{
    state.prefs.fontScale = +e.target.value; persist(); applyTheme();
  });

  $("export-data").addEventListener("click", ()=>{
    const blob = new Blob([JSON.stringify(state,null,2)],{type:"application/json"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "zuno-export-"+Date.now()+".json"; a.click();
    URL.revokeObjectURL(url); toast("Данные экспортированы");
  });

  $("clear-chat").addEventListener("click", ()=>{
    modal.open({
      title:"Очистить переписку?",
      text:"Все сообщения будут удалены без возможности восстановления.",
      actions:[
        {label:"Отмена", style:"ghost", onClick:closeModal},
        {label:"Очистить", style:"danger", onClick:(close)=>{
          state.chats = {}; persist(); renderChats();
          if (currentChatId){ currentChatId = null; }
          close(); toast("Переписка очищена");
        }}
      ]
    });
  });

  $("reset-settings").addEventListener("click", ()=>{
    modal.open({
      title:"Сбросить настройки?",
      text:"Профиль и переписка сохранятся. Сбросятся только предпочтения.",
      actions:[
        {label:"Отмена", style:"ghost", onClick:closeModal},
        {label:"Сбросить", style:"danger", onClick:(close)=>{
          state.prefs = structuredClone(defaults.prefs); persist(); renderSettings(); close(); toast("Настройки сброшены");
        }}
      ]
    });
  });

  $("delete-account").addEventListener("click", ()=>{
    modal.open({
      title:"Удалить аккаунт?",
      text:"Это удалит профиль, переписку и настройки безвозвратно.",
      actions:[
        {label:"Отмена", style:"ghost", onClick:closeModal},
        {label:"Удалить", style:"danger", onClick:(close)=>{
          LS.clear(); state = structuredClone(defaults); persist();
          close(); setStatus(false); show("s-phone");
          $("phone").value = ""; $("fb-phone").textContent = ""; toast("Аккаунт удалён");
        }}
      ]
    });
  });

  (function boot(){
    applyTheme();
    setStatus(false);
    if (state.phone) $("phone").value = state.phone;
    if (state.phone && state.chats && Object.keys(state.chats).length){
      enterApp();
    } else if (state.phone){
      enterApp();
    } else {
      $("phone").focus();
    }
    updateCount();
    refreshProfileUI();
  })();
})();
</script>
</body>
</html>
