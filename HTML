  document.querySelectorAll('#game [data-d]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('#game [data-d]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      currentDiff = btn.dataset.d;
      vibrate(10);
      initGame();
    });
  });

  // ============================================================
  // ЛИГИ
  // ============================================================
  function renderLeagues() {
    const pts = getLeaguePoints();
    const cur = getLeagueByPoints(pts);
    const next = LEAGUES[LEAGUES.indexOf(cur) + 1];

    $('leagueBigIcon').textContent = cur.icon;
    $('leagueBigIcon').style.color = cur.color;
    $('leagueBigIcon').style.background = cur.color + '26';
    $('leagueCurrentName').textContent = cur.name;
    $('leagueCurrentPts').textContent = pts + ' очков';

    if (next) {
      const range = next.min - cur.min;
      const progress = pts - cur.min;
      const pct = Math.max(0, Math.min(100, Math.round(progress / range * 100)));
      $('leagueProgress').style.width = pct + '%';
      $('leagueProgressFrom').textContent = pts;
      $('leagueProgressTo').textContent = next.min;
    } else {
      $('leagueProgress').style.width = '100%';
      $('leagueProgressFrom').textContent = 'Максимум';
      $('leagueProgressTo').textContent = pts;
    }

    const list = $('leagueList');
    list.innerHTML = '';
    LEAGUES.forEach(function (l) {
      const isCurrent = l.id === cur.id;
      const locked = pts < l.min;
      const item = document.createElement('div');
      item.className = 'league-item' + (isCurrent ? ' current' : '') + (locked ? ' locked' : '');
      item.innerHTML =
        '<div class="league-item-icon" style="background:' + l.color + '26;color:' + l.color + ';">' + l.icon + '</div>' +
        '<div class="league-item-name">' + l.name + '</div>' +
        '<div class="league-item-pts">' + (locked ? '🔒 ' + l.min : l.min + '+') + '</div>';
      list.appendChild(item);
    });
  }

